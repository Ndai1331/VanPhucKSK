<!-- Start Breadcrumb -->
<header class="public-page-header">
    <nav aria-label="Vị trí trang" class="w-full">
        <ol class="space-y-2 detached-breadcrumb">
            <li>
                <h1 class="public-page-title">@(pTitle ?? Title)</h1>
            </li>
        </ol>
    </nav>
</header>
<!-- End Breadcrumb -->
@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? pTitle { get; set; }
}
