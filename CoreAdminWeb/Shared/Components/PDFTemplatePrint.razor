@using CoreAdminWeb.Enums
@using CoreAdminWeb.Extensions
@using CoreAdminWeb.Helpers
@using CoreAdminWeb.Model
@using CoreAdminWeb.Model.KhamSucKhoes

<!-- Printable Medical Form Content -->
<div class="p-5 bg-white border rounded shadow-sm dark:bg-darklight dark:border-darkborder" id="medical-form-content">
    <section class="page">
        <div class="header">
            <div class="line1">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
            <div class="line2">Độc lập - Tự do - Hạnh phúc</div>
            <div class="underline"></div>
        </div>
        <div class="title">SỔ KHÁM SỨC KHỎE ĐỊNH KỲ</div>

        <div class="two-col">
            <div class="photo-container">
                <div class="photo">
                    Ảnh<br />(4 x 6 cm)<br />(đóng dấu ráp lai hoặc Scan
                    ảnh)
                </div>
            </div>

            <div>
                <div class="row">
                    <span class="nowrap dotted-ruled" style="--start: 180px">1. Họ và tên (viết chữ in hoa): @SelectedItem.benh_nhan?.full_name.ToUpper()</span>
                </div>
                <div class="row">
                    <span>2. Giới tính:</span> Nam <input type="checkbox" checked="@(SelectedItem.benh_nhan?.gioi_tinh == GioiTinh.Nam)" /><span class="gap"></span> Nữ <input type="checkbox" checked="@(SelectedItem.benh_nhan?.gioi_tinh == GioiTinh.Nu)" />
                </div>
                <div class="row">
                    <span class="dotted-ruled"
                          style="--width: 120px; --start: 80px">3. Sinh Ngày @(SelectedItem.benh_nhan?.ngay_sinh?.Day.ToString("00") ?? "")</span>
                    <span class="dotted-ruled"
                          style="--width: 80px; --start: 40px">tháng @(SelectedItem.benh_nhan?.ngay_sinh?.Month.ToString("00") ?? "")</span>
                    <span class="dotted-ruled"
                          style="--width: 90px; --start: 30px">năm @(SelectedItem.benh_nhan?.ngay_sinh?.Year.ToString() ?? "")</span>
                    <span class="dotted-ruled"
                          style="--width: 80px; --start: 38px">(Tuổi: @(SelectedItem.benh_nhan?.ngay_sinh != null ? (DateTime.Now.Year - SelectedItem.benh_nhan.ngay_sinh.Value.Year).ToString() : "")</span>)
                </div>
                <div class="row">
                    <span class="nowrap dotted-ruled" style="--start: 265px">4. Số CMND/CCCD/Hộ chiếu/định danh CD: @CoreHelpers.GetSafeString(SelectedItem.benh_nhan?.so_dinh_danh)</span>
                </div>
                <div class="row">
                    <span class="dotted-ruled"
                          style="--width: 300px; --start: 77px">
                        5. Cấp ngày @CoreHelpers.FormatDate(SelectedItem.benh_nhan?.ngay_cap)
                    </span>
                    <span class="dotted-ruled" style="--start: 40px">Tại @CoreHelpers.GetSafeString(SelectedItem.benh_nhan?.noi_cap)</span>
                </div>
                <div class="row">
                    <span class="dotted-ruled" style="--start: 105px">
                        6. Chỗ ở hiện tại @CoreHelpers.GetSafeString(SelectedItem.benh_nhan?.dia_chi)
                    </span>
                </div>
                <div class="row">
                    <span class="dotted-ruled" style="--start: 130px">
                        Số điện thoại liên hệ: @CoreHelpers.GetSafeString(SelectedItem.benh_nhan?.so_dien_thoai)
                    </span>
                </div>
            </div>
        </div>
        <div>
            <div class="note">
                <span class="important">* Lưu ý:</span> Trường hợp đối tượng
                KSK có CCCD gắn chíp hoặc có số định danh công dân đã thực
                hiện kết nối với cơ sở dữ liệu quốc gia về dân cư, phần HÀNH
                CHÍNH nêu trên chỉ cần ghi mục (1) Họ và tên, (3) Ngày tháng
                năm sinh, (4) số định danh công dân
            </div>

            <div class="row">
                <span class="dotted-ruled" style="--start: 100px">
                    7. Nghề nghiệp: @CoreHelpers.GetSafeString(SelectedKhamSucKhoeNgheNghiep?.nghe_nghiep)
                </span>
            </div>
            <div class="row">
                <span class="dotted-ruled" style="--start: 150px">
                    8. Nơi công tác, học tập: @CoreHelpers.GetSafeString(SelectedKhamSucKhoeNgheNghiep?.noi_cong_tac)
                </span>
            </div>
            <div class="row">
                <span class="dotted-ruled"
                      style="--width: 330px; --start: 290px">
                    9. Ngày bắt đầu vào làm việc tại đơn vị hiện nay: @(SelectedItem.benh_nhan?.ngay_sinh?.Day.ToString("00") ?? "")
                </span>
                <span class="dotted-ruled"
                      style="--width: 50px; --start: 5px">
                    / @(SelectedItem.benh_nhan?.ngay_sinh?.Month.ToString("00") ?? "")
                </span>
                <span class="dotted-ruled"
                      style="--width: 100px; --start: 5px">
                    / @(SelectedItem.benh_nhan?.ngay_sinh?.Year.ToString("00") ?? "")
                </span>
            </div>

            <div class="row">
                10. Nghề, công việc trước đây (liệt kê công việc đã làm
                trong 10 năm gần đây, tính từ thời điểm gần nhất):
            </div>
            <div class="row">
                <span class="dotted-ruled" style="--start: 13px">a) </span>
                <span class="dotted-ruled"
                      style="--width: 90px; --start: 80px">
                    thời gian làm
                </span>
            </div>
            <div class="row">
                <span class="dotted-ruled"
                      style="--width: 70px; --start: 30px">
                    việc
                </span>
                <span class="dotted-ruled"
                      style="--width: 70px; --start: 30px">
                    năm
                </span>
                <span class="dotted-ruled"
                      style="--width: 130px; --start: 85px">
                    tháng từ ngày
                </span>
                <span class="dotted-ruled"
                      style="--width: 50px; --start: 5px">
                    /
                </span>
                <span class="dotted-ruled"
                      style="--width: 70px; --start: 5px">
                    /
                </span>
                <span class="dotted-ruled"
                      style="--width: 70px; --start: 28px">
                    đến
                </span>
                <span class="dotted-ruled"
                      style="--width: 50px; --start: 5px">
                    /
                </span>
                <span class="dotted-ruled"
                      style="--width: 70px; --start: 5px">
                    /
                </span>
            </div>
            <div class="row">
                <span class="dotted-ruled" style="--start: 13px">b) </span>
                <span class="dotted-ruled"
                      style="--width: 90px; --start: 80px">
                    thời gian làm
                </span>
            </div>
            <div class="row">
                <span class="dotted-ruled"
                      style="--width: 70px; --start: 30px">
                    việc
                </span>
                <span class="dotted-ruled"
                      style="--width: 70px; --start: 30px">
                    năm
                </span>
                <span class="dotted-ruled"
                      style="--width: 130px; --start: 85px">
                    tháng từ ngày
                </span>
                <span class="dotted-ruled"
                      style="--width: 50px; --start: 5px">
                    /
                </span>
                <span class="dotted-ruled"
                      style="--width: 70px; --start: 5px">
                    /
                </span>
                <span class="dotted-ruled"
                      style="--width: 70px; --start: 28px">
                    đến
                </span>
                <span class="dotted-ruled"
                      style="--width: 50px; --start: 5px">
                    /
                </span>
                <span class="dotted-ruled"
                      style="--width: 70px; --start: 5px">
                    /
                </span>
            </div>

            <div class="row">
                <span class="dotted-ruled" style="--start: 205px">
                    11. Tiền sử bệnh, tật của gia đình:
                </span>
            </div>

            <div class="section">12. Tiền sử bệnh, tật của bản thân</div>
            <table>
                <thead>
                    <tr>
                        <th style="width: 36%">Tên bệnh</th>
                        <th style="width: 16%">Phát hiện năm</th>
                        <th style="width: 32%">Tên bệnh nghề nghiệp</th>
                        <th style="width: 16%">Phát hiện năm</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>a) @SelectedKhamSucKhoeTienSu.ten_benh</td>
                        <td>@SelectedKhamSucKhoeTienSu.nam_phat_hien</td>
                        <td>a) @SelectedKhamSucKhoeTienSu.benh_nghe_nghiep</td>
                        <td>@SelectedKhamSucKhoeTienSu.nam_phat_hien_benh_nghe_nghiep</td>
                    </tr>
                    <tr>
                        <td>b)</td>
                        <td></td>
                        <td>b)</td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>c)</td>
                        <td></td>
                        <td>c)</td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>d)</td>
                        <td></td>
                        <td>d)</td>
                        <td></td>
                    </tr>
                </tbody>
            </table>

            <table class="equal-col no-border">
                <tr>
                    <td>
                        <div class="signature">
                            <span class="bold">Người lao động xác nhận</span>
                            <span class="italic">(Ký và ghi rõ họ, tên)</span>
                        </div>
                    </td>
                    <td>
                        <div style="
         display: flex;
         align-items: flex-end;
         flex-direction: column;
        ">
                            <div class="row">
                                <span class="dotted-ruled"
                                      style="--width: 80px">.</span>
                                <span class="dotted-ruled"
                                      style="--width: 80px; --start: 40px">, ngày @DateTime.Now.Day</span>
                                <span class="dotted-ruled"
                                      style="--width: 80px; --start: 40px">tháng @DateTime.Now.Month</span>
                                <span class="dotted-ruled"
                                      style="--width: 100px; --start: 40px">năm @DateTime.Now.Year</span>
                            </div>
                            <div class="signature" style="width: 300px">
                                <span class="bold">
                                    Người lập sổ KSK định kỳ
                                </span>
                                <span class="italic">(Ký và ghi rõ họ, tên)</span>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </section>

    <section class="page">
        <div class="title">KHÁM SỨC KHỎE ĐỊNH KỲ</div>
        <div class="title">I. TIỀN SỬ BỆNH, TẬT</div>
        <div class="line1 center italic">
            (Bác sỹ khám sức khỏe hỏi và ghi chép)
        </div>
        <div class="row">
            <span class="dotted-ruled">@SelectedKhamSucKhoeTienSu.tien_su_gia_dinh</span>
        </div>

        @if (SelectedItem.benh_nhan?.gioi_tinh != null && SelectedItem.benh_nhan?.gioi_tinh == Enums.GioiTinh.Nu && SelectedKhamSucKhoeSanPhuKhoa != null)
        {
            <div class="row justify-between">
                <div class="flex">
                    <span class="bold">Tiền sử sản phụ khoa</span>
                    <span class="italic">(Đối với nữ):</span>
                </div>
            </div>
            <div class="row justify-between">
                <span>- Bắt đầu thấy kinh nguyệt năm bao nhiêu tuổi:</span>
                <div>
                    <table>
                        <tr>
                            @{
                                var tuoiBatDauKinhs = SelectedKhamSucKhoeSanPhuKhoa.tuoi_bat_dau_kinh?.ToString().ToCharArray();
                                if (tuoiBatDauKinhs == null || tuoiBatDauKinhs.Length < 2)
                                {
                                    tuoiBatDauKinhs = new char[] { ' ', ' ' }; // Default to "00" if not set
                                }
                            }
                            @foreach (var c in tuoiBatDauKinhs)
                            {
                                <td width="30px" height="25px" class="center">@c</td>
                            }
                        </tr>
                    </table>
                </div>
            </div>
            <div class="row align-center">
                <span>- Tính chất kinh nguyệt: </span>
                <span>Đều</span>
                <input type="checkbox" checked="@(@SelectedKhamSucKhoeSanPhuKhoa.tinh_chat_kinh == TinhChatKinh.Deu.ToString())" />
                <span>Không đều</span>
                <input type="checkbox" checked="@(@SelectedKhamSucKhoeSanPhuKhoa.tinh_chat_kinh == TinhChatKinh.KhongDeu.ToString())" />
            </div>
            <div class="row">
                <span class="mr-3">- Chu kỳ kinh:</span>
                <div class="row mr-3">
                    <table>
                        <tr>
                            @{
                                var chuKyKinhs = @SelectedKhamSucKhoeSanPhuKhoa.chu_ky_kinh?.ToCharArray();
                                if (chuKyKinhs == null || chuKyKinhs.Length < 2)
                                {
                                    chuKyKinhs = new char[] { ' ', ' ' }; // Default to "00" if not set
                                }
                            }
                            @foreach (var c in chuKyKinhs)
                            {
                                <td width="30px" height="25px" class="center">@c</td>
                            }
                        </tr>
                    </table>
                    ngày
                </div>
                <span class="ml-5 mr-3">Lượng kinh:</span>
                <div class="row">
                    <table>
                        <tr>
                            @{
                                var luongKinhs = @SelectedKhamSucKhoeSanPhuKhoa.luong_kinh?.ToCharArray();
                                if (luongKinhs == null || luongKinhs.Length < 2)
                                {
                                    luongKinhs = new char[] { ' ', ' ' }; // Default to "00" if not set
                                }
                            }
                            @foreach (var c in luongKinhs)
                            {
                                <td width="30px" height="25px" class="center">@c</td>
                            }
                        </tr>
                    </table>
                    ngày
                </div>
            </div>
            <div class="row align-center">
                <span>- Đau bụng kinh: </span>
                <span>Có</span>
                <input type="checkbox" checked="@(SelectedKhamSucKhoeSanPhuKhoa.dau_bung_kinh == true)" />
                <span>Không</span>
                <input type="checkbox" checked="@(SelectedKhamSucKhoeSanPhuKhoa.dau_bung_kinh == false)" />
            </div>
            <div class="row align-center">
                <span>- Đã lập gia đình: </span>
                <span>Có</span>
                <input type="checkbox" checked="@(SelectedKhamSucKhoeSanPhuKhoa.da_lap_gia_dinh == true)" />
                <span>Chưa</span>
                <input type="checkbox" checked="@(SelectedKhamSucKhoeSanPhuKhoa.da_lap_gia_dinh == false)" />
            </div>
            <div class="row">
                <span class="mr-3">- PARA:</span>
                <div>
                    <table>
                        <tr>
                            @{
                                var paras = SelectedKhamSucKhoeSanPhuKhoa.para?.Split('|');
                                if (paras == null || paras.Length < 4)
                                {
                                    paras = new string[] { "", "", "", "" }; // Default to "00" if not set
                                }
                            }
                            @foreach (var c in paras)
                            {
                                <td width="30px" height="25px" class="center">@c</td>
                            }
                        </tr>
                    </table>
                </div>
            </div>
            <div class="row align-center">
                <span>- Số lần mổ sản, phụ khoa: </span>
                <span>Có</span>
                <input type="checkbox" checked="@(SelectedKhamSucKhoeSanPhuKhoa.so_lan_mo_san_phu_khoa > 0)" />
                <span class="dotted-ruled ml-3 mr-1"
                      style="--width: 300px; --start: 43px">Ghi rõ: @SelectedKhamSucKhoeSanPhuKhoa.mo_san_phu_khoa_ghi_ro</span>
                <span>Không</span>
                <input type="checkbox" checked="@(SelectedKhamSucKhoeSanPhuKhoa.so_lan_mo_san_phu_khoa <= 0)" />
            </div>
            <div class="row align-center">
                <span>- Có đang áp dụng BPTT không?: </span>
                <span>Có</span>
                <input type="checkbox" checked="@(SelectedKhamSucKhoeSanPhuKhoa.ap_dung_bptt == true)" />
                <span class="dotted-ruled ml-3 mr-1"
                      style="--width: 300px; --start: 43px">Ghi rõ: @SelectedKhamSucKhoeSanPhuKhoa.bptt_ghi_ro</span>
                <span>Không</span>
                <input type="checkbox" checked="@(SelectedKhamSucKhoeSanPhuKhoa.ap_dung_bptt == false)" />
            </div>
        }
        <div class="title mt-3">II. KHÁM THỂ LỰC</div>
        <div class="row">
            <span class="dotted-ruled" style="--width: 120px; --start: 65px">
                Chiều cao: @SelectedKhamSucKhoeTheLuc.chieu_cao
            </span>
            <span class="dotted-ruled" style="--width: 150px; --start: 88px">
                cm; Cân nặng: @SelectedKhamSucKhoeTheLuc.can_nang
            </span>
            <span class="dotted-ruled" style="--width: 150px; --start: 92px">
                Kg; Chỉ số BMI: @SelectedKhamSucKhoeTheLuc.bmi
            </span>
        </div>
        <div class="row">
            <span class="dotted-ruled" style="--width: 250px; --start: 37px">
                Mạch: @SelectedKhamSucKhoeTheLuc.mach
            </span>
            <span class="dotted-ruled"
                  style="--width: 170px; --start: 112px">
                lần/phút; Huyết áp: @SelectedKhamSucKhoeTheLuc.huyet_ap
            </span>
            <span class="dotted-ruled" style="--width: 70px; --start: 7px">/</span>mmHg
        </div>
        <div class="row">
            <span class="dotted-ruled"
                  style="--width: 300px; --start: 105px">
                Phân loại thể lực: @SelectedKhamSucKhoeTheLuc.phan_loai?.name
            </span>
        </div>

        <div class="title mt-3">III. KHÁM LÂM SÀNG</div>

        <table>
            <colgroup>
                <col style="width: 5%" />
                <col style="width: 20%" />
                <col style="width: 55%" />
                <col style="width: 20%" />
            </colgroup>
            <thead>
                <tr>
                    <th class="center" colspan="3">
                        Nội dung khám<br />
                        <span class="normal">
                            phải khám đầy đủ các nội dung theo chuyên khoa
                            để khẳng định có/hay không có bệnh, tật theo quy
                            định tại Quyết định…
                        </span>
                    </th>
                    <th class="center">
                        Họ tên và chữ ký của Bác sỹ chuyên khoa
                    </th>
                </tr>
            </thead>
            <tbody class="td-tight">
                <!-- 1. Nội khoa -->
                <tr>
                    <td class="v-venter">
                        <span class="bold" style="vertical-align: middle">1.</span>
                    </td>
                    <td colspan="3">
                        <span class="bold">Nội khoa</span>
                    </td>
                </tr>
                <tr>
                    <td class="v-venter" rowspan="2">
                        <span>a)</span>
                    </td>
                    <td>
                        <span class="italic">Tuần hoàn</span>
                    </td>
                    <td>
                        @CoreHelpers.GetSafeString(SelectedKhamSucKhoeChuyenKhoa.kq_nk_tuan_hoan)
                    </td>
                    <td rowspan="2" class="center">
                        @RenderSignatureHandler(SelectedKhamSucKhoeChuyenKhoa.chu_ky_tuan_hoan, SelectedKhamSucKhoeChuyenKhoa.chu_ky_tuan_hoan, "tuan_hoan", 100, 50)
                        @CoreHelpers.GetSafeString(SelectedKhamSucKhoeChuyenKhoa.bs_tuan_hoan)
                    </td>
                </tr>
                <tr>
                    <td>
                        <span>Phân loại</span>
                    </td>
                    <td>
                        <span>@CoreHelpers.GetSafeString(SelectedKhamSucKhoeChuyenKhoa.pl_nk_tuan_hoan?.name)</span>
                    </td>
                </tr>
                <tr>
                    <td class="v-venter" rowspan="2">
                        <span>b)</span>
                    </td>
                    <td>
                        <span class="italic">Hô hấp</span>
                    </td>
                    <td>
                        @CoreHelpers.GetSafeString(SelectedKhamSucKhoeChuyenKhoa.kq_nk_ho_hap)
                    </td>
                    <td rowspan="2" class="center">
                        @RenderSignatureHandler(SelectedKhamSucKhoeChuyenKhoa.chu_ky_ho_hap, SelectedKhamSucKhoeChuyenKhoa.chu_ky_ho_hap, "ho_hap", 100, 50)
                        @CoreHelpers.GetSafeString(SelectedKhamSucKhoeChuyenKhoa.bs_ho_hap)
                    </td>
                </tr>
                <tr>
                    <td>
                        <span>Phân loại</span>
                    </td>
                    <td>
                        <span>@CoreHelpers.GetSafeString(SelectedKhamSucKhoeChuyenKhoa.pl_nk_ho_hap?.name)</span>
                    </td>
                </tr>
                <tr>
                    <td class="v-venter" rowspan="2">
                        <span>c)</span>
                    </td>
                    <td>
                        <span class="italic">Tiêu hóa</span>
                    </td>
                    <td>
                        @CoreHelpers.GetSafeString(SelectedKhamSucKhoeChuyenKhoa.kq_nk_tieu_hoa)
                    </td>
                    <td rowspan="2" class="center">
                        @RenderSignatureHandler(SelectedKhamSucKhoeChuyenKhoa.chu_ky_tieu_hoa, SelectedKhamSucKhoeChuyenKhoa.chu_ky_tieu_hoa, "tieu_hoa", 100, 50)
                        @CoreHelpers.GetSafeString(SelectedKhamSucKhoeChuyenKhoa.bs_tieu_hoa)
                    </td>
                </tr>
                <tr>
                    <td>
                        <span>Phân loại</span>
                    </td>
                    <td>
                        <span>@CoreHelpers.GetSafeString(SelectedKhamSucKhoeChuyenKhoa.pl_nk_tieu_hoa?.name)</span>
                    </td>
                </tr>
                <tr>
                    <td class="v-venter" rowspan="2">
                        <span>d)</span>
                    </td>
                    <td>
                        <span class="italic">Thận-Tiết niệu</span>
                    </td>
                    <td>
                        @CoreHelpers.GetSafeString(SelectedKhamSucKhoeChuyenKhoa.kq_nk_than_tiet_nieu)
                    </td>
                    <td rowspan="2" class="center">
                        @RenderSignatureHandler(SelectedKhamSucKhoeChuyenKhoa.chu_ky_than_tiet_nieu, SelectedKhamSucKhoeChuyenKhoa.chu_ky_than_tiet_nieu, "than_tiet_nieu", 100, 50)
                        @CoreHelpers.GetSafeString(SelectedKhamSucKhoeChuyenKhoa.bs_than_tiet_nieu)
                    </td>
                </tr>
                <tr>
                    <td>
                        <span>Phân loại</span>
                    </td>
                    <td>
                        <span>@CoreHelpers.GetSafeString(SelectedKhamSucKhoeChuyenKhoa.pl_nk_than_tiet_nieu?.name)</span>
                    </td>
                </tr>
                <tr>
                    <td class="v-venter" rowspan="2">
                        <span>đ)</span>
                    </td>
