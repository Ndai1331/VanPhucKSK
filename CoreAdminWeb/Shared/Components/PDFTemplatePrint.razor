@using CoreAdminWeb.Enums
@using CoreAdminWeb.Extensions
@using CoreAdminWeb.Helpers
@using CoreAdminWeb.Model
@using CoreAdminWeb.Model.KhamSucKhoes

<!-- Printable Medical Form Content -->
<div class=" relative overflow-x-auto p-5 bg-white border rounded shadow-sm dark:bg-darklight dark:border-darkborder" id="medical-form-content">
    <section class="page overflow-x-auto">
        <div class="header">
            <div class="line1">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
            <div class="line2">Độc lập - Tự do - Hạnh phúc</div>
            <div class="underline"></div>
        </div>
        <div class="title mb-2 mt-3">SỔ KHÁM SỨC KHỎE ĐỊNH KỲ</div>

        <!-- two columns using a table -->
        <table class="two-col-table">
            <tr>
                <td class="two-col-left">
                    <div class="photo v-center">
                        <span>
                            Ảnh<br />(4 x 6 cm)<br />(đóng dấu ráp lai hoặc
                            Scan ảnh)
                        </span>
                    </div>
                </td>
                <td>
                    <div class="row">
                        <span class="nowrap">1. Họ và tên (viết chữ in hoa):</span>
                        <span class="dotted-ruled" style="width: 103mm">@SelectedItem.benh_nhan?.full_name.ToUpper()</span>
                    </div>
                    <div class="row">
                        <span>2. Giới tính:</span>
                        <span class="gap"></span>
                        Nam @((MarkupString)(SelectedItem.benh_nhan?.gioi_tinh == GioiTinh.Nam ? "<span class=\"cb\" checked aria-hidden=\"true\"></span>" : "<span class=\"cb\" aria-hidden=\"true\"></span>"))
                        <span class="gap"></span>
                        Nữ @((MarkupString)(SelectedItem.benh_nhan?.gioi_tinh == GioiTinh.Nu ? "<span class=\"cb\" checked aria-hidden=\"true\"></span>" : "<span class=\"cb\" aria-hidden=\"true\"></span>"))
                    </div>
                    <div class="row">
                        <span class="dot-wrap">
                            <span class="inline">3. Sinh Ngày</span>
                            <span class="dotted-ruled" style="width: 10mm">@(SelectedItem.benh_nhan?.ngay_sinh?.Day.ToString("00") ?? "")</span>
                            <span>tháng</span>
                            <span class="dotted-ruled" style="width: 10mm">@(SelectedItem.benh_nhan?.ngay_sinh?.Month.ToString("00") ?? "")</span>
                            <span>năm</span>
                            <span class="dotted-ruled" style="width: 15mm">@(SelectedItem.benh_nhan?.ngay_sinh?.Year.ToString() ?? "")</span>
                            <span>(Tuổi:</span>
                            <span class="dotted-ruled" style="width: 14mm">@(SelectedItem.benh_nhan?.ngay_sinh != null ? (DateTime.Now.Year - SelectedItem.benh_nhan.ngay_sinh.Value.Year).ToString() : "")</span>
                            <span>)</span>
                        </span>
                    </div>
                    <div class="row">
                        <span class="nowrap">4. Số CMND/CCCD/Hộ chiếu/định danh CD:</span>
                        <span class="dotted-ruled" style="width: 80mm">@CoreHelpers.GetSafeString(SelectedItem.benh_nhan?.so_dinh_danh)</span>
                    </div>
                    <div class="row">
                        <span>5. Cấp ngày</span>
                        <span class="dotted-ruled" style="width: 35mm">@CoreHelpers.FormatDate(SelectedItem.benh_nhan?.ngay_cap)</span>
                        <span class="ml-2">Tại</span>
                        <span class="dotted-ruled" style="width: 86.5mm">@CoreHelpers.GetSafeString(SelectedItem.benh_nhan?.noi_cap)</span>
                    </div>
                    <div class="row">
                        <span>6. Chỗ ở hiện tại</span>
                        <span class="dotted-ruled" style="width: 123.5mm">@CoreHelpers.GetSafeString(SelectedItem.benh_nhan?.dia_chi)</span>
                    </div>
                    <div class="row">
                        <span>Số điện thoại liên hệ:</span>
                        <span class="dotted-ruled" style="width: 40mm">@CoreHelpers.GetSafeString(SelectedItem.benh_nhan?.so_dien_thoai)</span>
                    </div>
                </td>
            </tr>
        </table>

        <div class="row italic mb-2">
            <span class="bold">* Lưu ý:</span>
            Trường hợp đối tượng KSK có CCCD gắn chíp hoặc có số định danh
            công dân đã thực hiện kết nối với cơ sở dữ liệu quốc gia về dân
            cư, phần HÀNH CHÍNH nêu trên chỉ cần ghi mục (1) Họ và tên, (3)
            Ngày tháng năm sinh, (4) số định danh công dân
        </div>

        <div class="row">
            <span>7. Nghề nghiệp:</span><span class="dotted-ruled" style="width: 130mm">@CoreHelpers.GetSafeString(SelectedKhamSucKhoeNgheNghiep?.nghe_nghiep)</span>
        </div>
        <div class="row">
            <span>8. Nơi công tác, học tập:</span>
            <span class="dotted-ruled" style="width: 146.5mm">@CoreHelpers.GetSafeString(SelectedKhamSucKhoeNgheNghiep?.noi_cong_tac)</span>
        </div>

        <div class="row">
            <span>9. Ngày bắt đầu vào làm việc tại đơn vị hiện nay:</span>
            <span class="dotted-ruled" style="width: 10mm"></span>
            <span>/</span>
            <span class="dotted-ruled" style="width: 10mm"></span>
            <span>/</span>
            <span class="dotted-ruled" style="width: 40mm"></span>
        </div>

        <div class="row">
            10. Nghề, công việc trước đây (liệt kê công việc đã làm trong 10
            năm gần đây, tính từ thời điểm gần nhất):
        </div>

        <div class="row">
            <span>a)</span>
            <span class="dotted-ruled" style="width: 160mm"></span>
            <span>thời gian làm việc</span>
            <span class="dotted-ruled" style="width: 10mm"></span>
            <span>năm</span>
            <span class="dotted-ruled" style="width: 10mm"></span>
            <span>tháng từ ngày</span>
            <span class="dotted-ruled" style="width: 10mm"></span>
            <span>/</span>
            <span class="dotted-ruled" style="width: 10mm"></span>
            <span>/</span>
            <span class="dotted-ruled" style="width: 15mm"></span>
            <span>đến</span>
            <span class="dotted-ruled" style="width: 10mm"></span>
            <span>/</span>
            <span class="dotted-ruled" style="width: 10mm"></span>
            <span>/</span>
            <span class="dotted-ruled" style="width: 15mm"></span>
        </div>

        <div class="row">
            <span>b)</span>
            <span class="dotted-ruled" style="width: 160mm"></span>
            <span>thời gian làm việc</span>
            <span class="dotted-ruled" style="width: 10mm"></span>
            <span>năm</span>
            <span class="dotted-ruled" style="width: 10mm"></span>
            <span>tháng từ ngày</span>
            <span class="dotted-ruled" style="width: 10mm"></span>
            <span>/</span>
            <span class="dotted-ruled" style="width: 10mm"></span>
            <span>/</span>
            <span class="dotted-ruled" style="width: 15mm"></span>
            <span>đến</span>
            <span class="dotted-ruled" style="width: 10mm"></span>
            <span>/</span>
            <span class="dotted-ruled" style="width: 10mm"></span>
            <span>/</span>
            <span class="dotted-ruled" style="width: 15mm"></span>
        </div>

        <div class="row">
            <span>11. Tiền sử bệnh, tật của gia đình:</span>
            @if (!string.IsNullOrEmpty(SelectedKhamSucKhoeTienSu?.tien_su_gia_dinh))
            {
                splitCount = 0;
                foreach (var splitStr in SelectedKhamSucKhoeTienSu.tien_su_gia_dinh.WrapToWidthMm())
                {
                    splitCount++;
                    <span class="dotted-ruled" style="width: 100%"><span style="white-space: pre-wrap">@splitStr</span></span>
                }

                if (splitCount < 4)
                {
                    for (int i = 0; i < 4 - splitCount; i++)
                    {
                        <span class="dotted-ruled" style="width: 100%"></span>
                    }
                }
            }
            else
            {
                <span class="dotted-ruled" style="width: 100%"></span>
                <span class="dotted-ruled" style="width: 100%"></span>
                <span class="dotted-ruled" style="width: 100%"></span>
                <span class="dotted-ruled" style="width: 100%"></span>
            }
        </div>

        <div class="title mt-3">12. Tiền sử bệnh, tật của bản thân</div>
        <table>
            <thead>
                <tr>
                    <th style="width: 36%">Tên bệnh</th>
                    <th style="width: 16%">Phát hiện năm</th>
                    <th style="width: 32%">Tên bệnh nghề nghiệp</th>
                    <th style="width: 16%">Phát hiện năm</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>a) @SelectedKhamSucKhoeTienSu?.ten_benh</td>
                    <td>@SelectedKhamSucKhoeTienSu?.nam_phat_hien</td>
                    <td>a) @SelectedKhamSucKhoeTienSu?.benh_nghe_nghiep</td>
                    <td>@SelectedKhamSucKhoeTienSu?.nam_phat_hien_benh_nghe_nghiep</td>
                </tr>
                <tr>
                    <td>b)</td>
                    <td></td>
                    <td>b)</td>
                    <td></td>
                </tr>
                <tr>
                    <td>c)</td>
                    <td></td>
                    <td>c)</td>
                    <td></td>
                </tr>
                <tr>
                    <td>d)</td>
                    <td></td>
                    <td>d)</td>
                    <td></td>
                </tr>
            </tbody>
        </table>

        <table class="outer-table no-border mt-3" style="width: 100%">
            <tr>
                <td style="width: 50%; text-align: center">
                    <div class="signature-box">
                        <span class="bold">Người lao động xác nhận</span>
                        <br />
                        <span class="italic mb-5">(Ký và ghi rõ họ, tên)</span>
                        <br />
                        <div style="height: 20mm"></div>
                        <span class="bold">@SelectedItem.benh_nhan?.full_name</span>
                    </div>
                </td>
                <td style="width: 50%">
                    <div class="signature-box">
                        <div class="row">
                            <span class="dotted-ruled" style="width: 20mm"></span>
                            <span>, ngày</span>
                            <span class="dotted-ruled" style="width: 9mm">@((SelectedItem.ngay_lap_so ?? DateTime.Now).Day)</span>
                            <span>tháng</span>
                            <span class="dotted-ruled" style="width: 9mm">@((SelectedItem.ngay_lap_so ?? DateTime.Now).Month)</span>
                            <span>năm</span>
                            <span class="dotted-ruled" style="width: 14mm">@((SelectedItem.ngay_lap_so ?? DateTime.Now).Year)</span>
                        </div>
                        <span class="bold">Người lập sổ KSK định kỳ</span>
                        <br />
                        <span class="italic">(Ký và ghi rõ họ, tên)</span>
                        <br />
                        <div style="height: 20mm"></div>
                        <span class="bold">@SelectedItem.nguoi_lap</span>
                    </div>
                </td>
            </tr>
        </table>
    </section>

    <section class="page overflow-x-auto">
        <div class="title">KHÁM SỨC KHỎE ĐỊNH KỲ</div>
        <div class="title mt-1">I. TIỀN SỬ BỆNH, TẬT</div>
        <div class="center italic mt-1">
            (Bác sỹ khám sức khỏe hỏi và ghi chép)
        </div>

        <div class="row">
            @if (!string.IsNullOrEmpty(SelectedKhamSucKhoeTienSu?.tien_su_gia_dinh))
            {
                splitCount = 0;
                foreach (var splitStr in SelectedKhamSucKhoeTienSu.tien_su_gia_dinh.WrapToWidthMm())
                {
                    splitCount++;
                    <span class="dotted-ruled" style="width: 100%"><span style="white-space: pre-wrap">@splitStr</span></span>
                }

                if (splitCount < 4)
                {
                    for (int i = 0; i < 4 - splitCount; i++)
                    {
                        <span class="dotted-ruled" style="width: 100%"></span>
                    }
                }
            }
            else
            {
                <span class="dotted-ruled" style="width: 100%"></span>
                <span class="dotted-ruled" style="width: 100%"></span>
                <span class="dotted-ruled" style="width: 100%"></span>
                <span class="dotted-ruled" style="width: 100%"></span>
            }
        </div>

        <div class="row">
            <div class="mt-2"></div>
            <span class="bold">
                Tiền sử sản phụ khoa
                <span class="italic">(Đối với nữ)</span>:
            </span>
        </div>

        <div class="row">
            <table>
                <tr>
                    <td class="v-middle no-border">
                        <span>
                            - Bắt đầu thấy kinh nguyệt năm bao nhiêu tuổi:
                        </span>
                    </td>
                    <td class="v-middle no-border">
                        <table class="auto mt-0">
                            <tr>
                                @{
                                    var tuoiBatDauKinhs = SelectedKhamSucKhoeSanPhuKhoa?.tuoi_bat_dau_kinh?.ToString().PadLeft(2, '0').ToCharArray();
                                    if (tuoiBatDauKinhs == null || tuoiBatDauKinhs.Length < 2)
                                    {
                                        tuoiBatDauKinhs = new char[] { ' ', ' ' }; // Default to "00" if not set
                                    }
                                }
                                @foreach (var c in tuoiBatDauKinhs)
                                {
                                    <td width="30" height="30" class="center v-middle">@c</td>
                                }
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>

        <div class="row">
            <span>
                - Tính chất kinh nguyệt:
            </span>
            <span class="gap"></span>
            Đều @((MarkupString)(SelectedKhamSucKhoeSanPhuKhoa?.tinh_chat_kinh == TinhChatKinh.Deu.ToString() ? "<span class=\"cb\" checked aria-hidden=\"true\"></span>" : "<span class=\"cb\" aria-hidden=\"true\"></span>"))
            <span class="gap"></span>
            Không đều @((MarkupString)(SelectedKhamSucKhoeSanPhuKhoa?.tinh_chat_kinh == TinhChatKinh.KhongDeu.ToString() ? "<span class=\"cb\" checked aria-hidden=\"true\"></span>" : "<span class=\"cb\" aria-hidden=\"true\"></span>"))
        </div>

        <div class="row">
            <table class="auto">
                <tr>
                    <td class="v-middle no-border">
                        <span>
                            - Chu kỳ kinh:
                        </span>
                    </td>
                    <td class="v-middle no-border">
                        <table class="auto mt-0">
                            <tr>
                                @{
                                    var chuKyKinhs = @SelectedKhamSucKhoeSanPhuKhoa?.chu_ky_kinh?.PadLeft(2, ' ').ToCharArray();
                                    if (chuKyKinhs == null || chuKyKinhs.Length < 2)
                                    {
                                        chuKyKinhs = new char[] { ' ', ' ' }; // Default to "00" if not set
                                    }
                                }
                                @foreach (var c in chuKyKinhs)
                                {
                                    <td width="30" height="30" class="center v-middle">@c</td>
                                }
                            </tr>
                        </table>
                    </td>
                    <td class="v-middle no-border" width="120px">
                        <span>
                            ngày
                        </span>
                    </td>
                    <td class="v-middle no-border">
                        <span>
                            Lượng kinh:
                        </span>
                    </td>
                    <td class="v-middle no-border">
                        <table class="auto mt-0">
                            <tr>
                                @{
                                    var luongKinhs = @SelectedKhamSucKhoeSanPhuKhoa?.luong_kinh?.PadLeft(2, ' ').ToCharArray();
                                    if (luongKinhs == null || luongKinhs.Length < 2)
                                    {
                                        luongKinhs = new char[] { ' ', ' ' }; // Default to "00" if not set
                                    }
                                }
                                @foreach (var c in luongKinhs)
                                {
                                    <td width="30" height="30" class="center v-middle">@c</td>
                                }
                            </tr>
                        </table>
                    </td>
                    <td class="v-middle no-border">
                        <span>
                            ngày
                        </span>
                    </td>
                </tr>
            </table>
        </div>

        <div class="row">
            <span>
                - Đau bụng kinh:
            </span>
            <span class="gap"></span>
            Có @((MarkupString)(SelectedKhamSucKhoeSanPhuKhoa?.dau_bung_kinh == true ? "<span class=\"cb\" checked aria-hidden=\"true\"></span>" : "<span class=\"cb\" aria-hidden=\"true\"></span>"))
            <span class="gap"></span>
            Không @((MarkupString)(SelectedKhamSucKhoeSanPhuKhoa?.dau_bung_kinh == false ? "<span class=\"cb\" checked aria-hidden=\"true\"></span>" : "<span class=\"cb\" aria-hidden=\"true\"></span>"))
        </div>
        <div class="row">
            <span>
                - Đã lập gia đình:
            </span>
            <span class="gap"></span>
            Có @((MarkupString)(SelectedKhamSucKhoeSanPhuKhoa?.da_lap_gia_dinh == true ? "<span class=\"cb\" checked aria-hidden=\"true\"></span>" : "<span class=\"cb\" aria-hidden=\"true\"></span>"))
            <span class="gap"></span>
            Chưa @((MarkupString)(SelectedKhamSucKhoeSanPhuKhoa?.da_lap_gia_dinh == false ? "<span class=\"cb\" checked aria-hidden=\"true\"></span>" : "<span class=\"cb\" aria-hidden=\"true\"></span>"))
        </div>

        <div class="row">
            <table class="auto">
                <tr>
                    <td class="v-middle no-border">
                        <span>
                            - PARA:
                        </span>
                    </td>
                    <td class="v-middle no-border">
                        <table class="auto mt-0">
                            <tr>
                                @{
                                    var paras = SelectedKhamSucKhoeSanPhuKhoa?.para?
                                    .Split(new[] { '|', '-' }, StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
                                    if (paras.Length == 1)
                                    {
                                        paras = SelectedKhamSucKhoeSanPhuKhoa?.para?.SplitStringByTwoChars();
                                    }
                                    if (paras == null)
                                    {
                                        paras = new[] { "", "", "", "" };
                                    }

                                    if (paras.Length < 4)
                                    {
                                        var tempList = paras.ToList();
                                        for (int i = tempList.Count - 1; i < 4; i++)
                                        {
                                            tempList.Add("");
                                        }
                                        paras = tempList.ToArray();
                                    }
                                }
                                @foreach (var c in paras)
                                {
                                    <td width="30" height="30" class="center v-middle">@c</td>
                                }
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>

        <div class="row">
            <span>
                - Số lần mổ sản, phụ khoa:
            </span>
            <span class="ml-2">Có</span> @((MarkupString)(SelectedKhamSucKhoeSanPhuKhoa?.so_lan_mo_san_phu_khoa == (int)YesNo.Co ? "<span class=\"cb\" checked aria-hidden=\"true\"></span>" : "<span class=\"cb\" aria-hidden=\"true\"></span>"))
            <span class="ml-2">Ghi rõ</span>
            <span class="dotted-ruled" style="width: 80mm">@SelectedKhamSucKhoeSanPhuKhoa?.mo_san_phu_khoa_ghi_ro</span>
            <span class="ml-2">Không</span> @((MarkupString)(SelectedKhamSucKhoeSanPhuKhoa?.so_lan_mo_san_phu_khoa == (int)YesNo.Khong ? "<span class=\"cb\" checked aria-hidden=\"true\"></span>" : "<span class=\"cb\" aria-hidden=\"true\"></span>"))
        </div>

        <div class="row">
            <span>
                - Có đang áp dụng BPTT không?
            </span>
            <span class="ml-2">Có</span> @((MarkupString)(SelectedKhamSucKhoeSanPhuKhoa?.ap_dung_bptt == true ? "<span class=\"cb\" checked aria-hidden=\"true\"></span>" : "<span class=\"cb\" aria-hidden=\"true\"></span>"))
            <span class="ml-2">Ghi rõ</span>
            <span class="dotted-ruled" style="width: 80mm">@SelectedKhamSucKhoeSanPhuKhoa?.bptt_ghi_ro</span>
            <span class="ml-2">Không</span> @((MarkupString)(SelectedKhamSucKhoeSanPhuKhoa?.ap_dung_bptt == false ? "<span class=\"cb\" checked aria-hidden=\"true\"></span>" : "<span class=\"cb\" aria-hidden=\"true\"></span>"))
        </div>

        <div class="title mt-3">II. KHÁM THỂ LỰC</div>
        <div class="row">
            <span>Chiều cao:</span>
            <span class="dotted-ruled" style="width: 30mm">@SelectedKhamSucKhoeTheLuc?.chieu_cao</span>
            <span>cm; Cân nặng:</span>
            <span class="dotted-ruled" style="width: 30mm">@SelectedKhamSucKhoeTheLuc?.can_nang</span>
            <span>Kg; Chỉ số BMI:</span>
            <span class="dotted-ruled" style="width: 30mm">@SelectedKhamSucKhoeTheLuc?.bmi</span>
        </div>
        <div class="row">
            <span>Mạch:</span>
            <span class="dotted-ruled" style="width: 30mm">@SelectedKhamSucKhoeTheLuc?.mach</span>
            <span>lần/phút; Huyết áp:</span>
            @if (!string.IsNullOrEmpty(@SelectedKhamSucKhoeTheLuc?.huyet_ap))
            {
                <span class="dotted-ruled" style="width: 30mm">@SelectedKhamSucKhoeTheLuc?.huyet_ap</span>
            }
            else
            {
                <span class="dotted-ruled" style="width: 15mm"></span>
                <span>/</span>
                <span class="dotted-ruled" style="width: 15mm"></span>
            }
            <span>mmHg</span>
        </div>
        <div class="row">
            <span>Phân loại thể lực:</span>
            <span class="dotted-ruled" style="width: 120mm">@SelectedKhamSucKhoeTheLuc?.phan_loai?.name</span>
        </div>

        <div class="title mt-3">III. KHÁM LÂM SÀNG</div>

        <table style="width:100%; border-collapse:collapse; table-layout:fixed;">
            <tr style="height:0; visibility:hidden;">
                <td style="width:8mm; border:0 !important; padding:0 !important; margin:0;font-size:0; line-height:0; height:0; background:transparent;">&nbsp;</td>
                <td style="width:22mm; border:0 !important; padding:0 !important; margin:0;font-size:0; line-height:0; height:0; background:transparent;">&nbsp;</td>
                <td style="width:120mm; border:0 !important; padding:0 !important; margin:0;font-size:0; line-height:0; height:0; background:transparent;">&nbsp;</td>
                <td style="width:30mm; border:0 !important; padding:0 !important; margin:0;font-size:0; line-height:0; height:0; background:transparent;">&nbsp;</td>
            </tr>
            <tr>
                <td class="center" colspan="3">
                    <b>Nội dung khám</b><br />
                    <span>
                        phải khám đầy đủ các nội dung theo chuyên khoa
                        để khẳng định có/hay không có bệnh, tật theo quy
                        định tại Quyết định…
                    </span>
                </td>
                <td class="center">
                    <b>Họ tên và chữ ký của Bác sỹ chuyên khoa</b>
                </td>
            </tr>
            <tr>
                <td class="v-middle bold">1.</td>
                <td colspan="3" class="bold">Nội khoa</td>
            </tr>
