@using CoreAdminWeb.Model




<ul class="folder-tree" role="tree">
    @foreach (var folder in Folders)
    {
        <li class="@(folder.id == Guid.Empty ? "" : "px-4")">
            <div class="folder-tree-row">
                <button type="button" class="folder-tree-select @(folder.isSelected ? "is-selected" : "")" role="treeitem" @onclick="() => OnSelectFolder(folder)" aria-label="Mở thư mục @folder.name">
                    <span class="material-symbols-outlined" aria-hidden="true">folder</span>
                    <span class="folder-tree-label">@folder.name</span>
                </button>
                @if (folder.sub_folders != null && folder.sub_folders.Any())
                {
                    <button type="button" class="folder-tree-toggle" @onclick="() => Toggle(folder)" aria-label="@(folder.isOpen ? $"Thu gọn {folder.name}" : $"Mở rộng {folder.name}")" aria-expanded="@folder.isOpen">
                        <span class="material-symbols-outlined" aria-hidden="true">@(folder.isOpen ? "expand_more" : "chevron_right")</span>
                    </button>
                }
            </div>
            @if (folder.isOpen && folder.sub_folders != null && folder.sub_folders.Any())
            {
                <FolderTree Folders="folder.sub_folders" OnSelect="OnSelect" />
            }
        </li>
    }
</ul>

@code {
    [Parameter]
    public List<FolderModel> Folders { get; set; }

    [Parameter]
    public EventCallback<FolderModel> OnSelect { get; set; }

    // Toggle trạng thái mở/đóng
    void Toggle(FolderModel folder)
    {
        if (folder.sub_folders != null && folder.sub_folders.Any())
            folder.isOpen = !folder.isOpen;
    }

    private async Task OnSelectFolder(FolderModel folder)
    {
        if (OnSelect.HasDelegate)
            await OnSelect.InvokeAsync(folder);
    }
}
