@using CoreAdminWeb.Model
@using Microsoft.JSInterop
@using MudBlazor

<div class="flex flex-col gap-4">
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
        @foreach (var file in Files)
        {
            var fileType = file.GetFileType();
            <div class="card p-3 relative file-item-card" role="button" tabindex="0" @onclick="() => OnSelectFile(file)" @onkeydown="(e) => OnSelectFileKeyDown(e, file)">
                <div class="header">
                    @if(!string.IsNullOrEmpty(fileType.Item2))
                    {
                      <span class="material-symbols-outlined block" aria-hidden="true" style="position: relative;
                            z-index: 1;
                            display: flex !important;
                            align-items: center;
                            justify-content: center;
                            width: 100%;
                            overflow: hidden;
                            border-radius: 10px;
                            font-size: 48px;
                            border: none;
                            min-height: 100px;">@fileType.Item2</span>
                    }else
                    {
                        <MudImage Src="@file.filename_disk" FallbackSrc="assets/images/no-image-available.svg" Class="object-cover " style="position: relative;
                        z-index: 1;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        width: 100%;
                        overflow: hidden;
                        border-radius: 10px;
                        border:none;" alt="@file.title"/>
                    }
                  
                </div>
                <div class="title">
                    <MudText Typo="Typo.h5" Class="text-lg font-bold dark:text-white">@file.GetMinifiedFileName()</MudText>
                </div>
                <div class="subtitle">
                    <p class="text-muted dark:text-darkmuted">@file.type_file - @file.GetFileSize()</p>
                    <a @onclick:stopPropagation @onkeydown:stopPropagation="true" href="@file.url_download" target="_blank" download="" aria-label="Tải xuống @file.GetMinifiedFileName()" title="Tải xuống file">
                        <span class="text-purple material-symbols-outlined" aria-hidden="true">download</span>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public List<FileModel> Files { get; set; }

    [Parameter]
    public EventCallback<FileModel> OnSelect { get; set; }

    private async Task OnSelectFile(FileModel file)
    {
        if (OnSelect.HasDelegate)
            await OnSelect.InvokeAsync(file);
    }

    private async Task OnSelectFileKeyDown(KeyboardEventArgs e, FileModel file)
    {
        if (e.Key is "Enter" or " ")
        {
            await OnSelectFile(file);
        }
    }

}
