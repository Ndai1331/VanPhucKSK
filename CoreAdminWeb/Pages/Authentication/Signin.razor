@page "/signin"
@using CoreAdminWeb.Services
@using CoreAdminWeb.Services.Users
@layout CoreAdminWeb.Shared.Layout.AuthLayout
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject AlertService AlertService
@inject IUserService UserService

<div class="login-wrapper">
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <div class="login-card">
        <div class="login-header">
            <div class="login-icon">
                <i class="fas fa-user-shield"></i>
            </div>
            <h4 class="login-title text-uppercase">Đăng nhập</h4>
            <p class="login-subtitle">Vui lòng đăng nhập để xem kết quả KCB</p>
        </div>

        <div class="login-body">
            <form id="patientLoginForm" class="needs-validation" novalidate aria-busy="@isLoading" @onsubmit="HandleSignIn" @onsubmit:preventDefault="true">
                <div class="mb-2">
                    <label for="patient-phone" class="form-label">Số điện thoại</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true"><i class="fas fa-user"></i></span>
                        <InputText @bind-Value="_phone" type="tel" name="phone" autocomplete="username" inputmode="tel" required class="form-control" id="patient-phone" placeholder="Nhập số điện thoại" aria-describedby="patient-phone-hint" />
                    </div>
                    <small id="patient-phone-hint" class="form-text">Dùng số điện thoại đã đăng ký tại bệnh viện.</small>
                </div>

                <div class="mb-2">
                    <label for="patient-password" class="form-label">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true"><i class="fas fa-lock"></i></span>
                        <InputText @bind-Value="_password" type="password" name="password" autocomplete="current-password" required class="form-control" id="patient-password" placeholder="Nhập mật khẩu" />
                    </div>
                </div>

                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="rememberPatient" name="rememberPatient">
                    <label class="form-check-label" for="rememberPatient">
                        Ghi nhớ đăng nhập
                    </label>
                </div>
                @if (!string.IsNullOrWhiteSpace(_validationMessage))
                {
                    <div class="login-validation-message" role="alert">@_validationMessage</div>
                }
                <button type="submit" class="btn btn-login w-100 mb-2" disabled="@isLoading" aria-busy="@isLoading">
                    @if (isLoading)
                    {
                        <i class="fas fa-spinner fa-spin me-2"></i>
                    }
                    else
                    {
                        <i class="fas fa-sign-in-alt me-2"></i>
                    }
                    Đăng nhập
                </button>
               
                <div class="back-link">
                    <a href="/admin-signin">
                        <i class="fas fa-arrow-left"></i>
                        Đăng nhập quản trị hệ thống
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
@code {

    private string _phone = string.Empty, _password = string.Empty;
    private bool isLoading = false;
    private string? _validationMessage;

    private async Task HandleSignIn()
    {
        _validationMessage = null;
        if (string.IsNullOrEmpty(_password) || string.IsNullOrEmpty(_phone))
        {
            _validationMessage = "Vui lòng nhập số điện thoại và mật khẩu.";
            return;
        }

        isLoading = true;
        try
        {
            var response = await UserService.LoginAsync(_phone, _password);
            if (response.IsSuccess)
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
                {
                    AlertService.ShowAlert("Đăng nhập thành công!", "success");
                    Navigation.NavigateTo("/",forceLoad: true);
                }
                else
                {
                    _validationMessage = "Chưa đăng nhập thành công. Vui lòng thử lại.";
                    AlertService.ShowAlert("Chưa đăng nhập thành công!", "warning");
                }
            }
            else
            {
                _validationMessage = response.Message ?? "Thông tin đăng nhập chưa đúng.";
                AlertService.ShowAlert(_validationMessage, "danger");
            }
        }
        catch
        {
            _validationMessage = "Không thể kết nối đến hệ thống. Vui lòng thử lại.";
            AlertService.ShowAlert(_validationMessage, "danger");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleGlobalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await HandleSignIn();
        }
    }
}
