@page "/admin/bao-cao-thoi-gian-thu-hien-hop-dong"
@using CoreAdminWeb.Commons.Helpers
@using CoreAdminWeb.Commons.Utils
@using CoreAdminWeb.Extensions
@using CoreAdminWeb.Helpers
@using CoreAdminWeb.Model
@using CoreAdminWeb.Services.BaseServices
@using CoreAdminWeb.Shared.Base
@inherits BlazorCoreBase
@layout Shared.Layout.AdminLayout

<PageHeader Title="Báo cáo thời gian thực hiện hợp đồng" pTitle="Báo cáo thời gian thực hiện hợp đồng"></PageHeader>

<!-- Start All Card -->
<div class="flex flex-col gap-4 min-h-[calc(100vh-212px)]">
    <div class="grid grid-cols-1 gap-4">
        <div class="card mb-10">
            <div class="flex items-end justify-between flex-1 gap-2 sm:gap-4">
                <!-- Left: Filter Area -->
                <div class="w-full grid grid-cols-1 gap-4 md:grid-cols-4 xl:grid-cols-4 sm:gap-4 pb-2">
                    <div class="w-full xs:col-span-4 sm:col-span-4 md:col-span-1 xl:col-span-1">
                        <MudText Typo="Typo.h2" Class="mb-1 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Ngày</MudText>
                        <div class="flex items-center gap-2 sm:gap-4">
                            <input type="text"
                                class="form-input date-picker w-1/2"
                                placeholder="Từ ngày"
                                value="@(_fromDate?.ToString("dd/MM/yyyy"))"
                                @onchange="@(e => OnDateChanged(e, nameof(_fromDate), true))" />
                            <span class="mx-2 flex items-center text-gray-500">-</span>
                            <input type="text"
                                class="form-input date-picker w-1/2"
                                placeholder="Đến ngày"
                                value="@(_toDate?.ToString("dd/MM/yyyy"))"
                                @onchange="@(e => OnDateChanged(e, nameof(_toDate), true))" />
                        </div>
                    </div>
                    <div class="w-full xs:col-span-4 sm:col-span-4 md:col-span-1 xl:col-span-1">
                        <MudText Typo="Typo.h2" Class="mb-1 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Tên công ty</MudText>
                        <BlazoredTypeahead EnableDropDown="true"
                                           ShowDropDownOnFocus="true"
                                           MinimumLength="0"
                                           TItem="CongTyModel"
                                           TValue="CongTyModel"
                                           SearchMethod="LoaCongTyFilterData"
                                           Value="_selectedCongTyFilter"
                                           ValueExpression="@(() => _selectedCongTyFilter)"
                                           ValueChanged="OnCongTyFilterChanged"
                                           placeholder="Chọn công ty"
                                           Class="form-select">
                            <SelectedTemplate Context="item">
                                @item.name
                            </SelectedTemplate>
                            <ResultTemplate Context="item">
                                @item.name
                            </ResultTemplate>
                            <NotFoundTemplate Context="item">
                                Không tìm thấy dữ liệu
                            </NotFoundTemplate>
                        </BlazoredTypeahead>
                    </div>
                    <div class="w-full xs:col-span-4 sm:col-span-4 md:col-span-1 xl:col-span-1">
                        <MudForm class="flex-1">
                            <MudText Typo="Typo.h2" Class="mb-1 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Trạng thái</MudText>
                            <select class="form-select" @bind="_searchStatusString" @bind:event="oninput" @onchange="OnStatusFilterChanged">
                                <option value="">Tất cả</option>
                                @foreach (var item in TrangThaiHopDongList)
                                {
                                    <option value="@item">@item.GetDescription()</option>
                                }
                            </select>
                        </MudForm>
                    </div>

                    <div class="w-full flex flex-wrap items-end justify-end xs:col-span-4 sm:col-span-4 md:col-span-1 xl:col-span-1 gap-2">
                        @* <div> *@
                            <MudButton Class="w-full sm:w-auto md:w-auto btn flex items-center justify-center gap-1.5
                            bg-success border-success text-white hover:bg-success/[0.85]
                            hover:border-success/[0.85] text-nowrap" @onclick="@(e => LoadData(true))">
                                <i class="ri-search-line"></i>
                                Thống kê
                            </MudButton>
                            <MudButton Class="w-full sm:w-auto md:w-auto btn flex items-center justify-center gap-1.5
                            bg-info border-info text-white hover:bg-info/[0.85] hover:border-info/[0.85]
                            text-nowrap" OnClick="OnExcelExport">
                                <i class="ri-file-excel-2-fill"></i>
                                Xuất excel
                            </MudButton>
                        @* </div> *@
                    </div>
                </div>
            </div>

            <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
                <table id="example" class="display" style="width:100%">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Công ty</th>
                            <th>Mã hợp đồng</th>
                            <th>Ngày ký</th>
                            <th>Ngày hết hạn HĐ</th>
                            <th>Ngày nghiệm thu HĐ</th>
                            <th>Ngày thanh toán</th>
                            <th>Ngày dự kiến khám</th>
                            <th>Ngày kết thúc</th>
                            <th>So sánh khám - nghiệm thu (ngày)</th>
                            <th>So sánh khám - thanh toán (ngày)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in MainModels.Select((v, i) => new { Data = v, Index = i }))
                        {
                            <tr>
                                <td>@(((Page - 1) * PageSize) + item.Index + 1)</td>
                                <td style="min-width: 300px; white-space: pre-wrap;">@item.Data.cong_ty?.name</td>
                                <td>@item.Data.code</td>
                                <td>@item.Data.ngay_hop_dong?.ToString("dd/MM/yyyy")</td>
                                <td>@item.Data.ngay_het_han?.ToString("dd/MM/yyyy")</td>
                                <td>@item.Data.ngay_nghiem_thu_hd?.ToString("dd/MM/yyyy")</td>
                                <td>@item.Data.ngay_thanh_toan?.ToString("dd/MM/yyyy")</td>
                                <td>@item.Data.cau_hinh_ho_so_ksk?.OrderByDescending(x => x.ngay_du_kien_kham).FirstOrDefault()?.ngay_du_kien_kham?.ToString("dd/MM/yyyy")</td>
                                <td>@item.Data.cau_hinh_ho_so_ksk?.OrderByDescending(x => x.ngay_ket_thuc).FirstOrDefault()?.ngay_ket_thuc?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @{
                                        var ngayNghiemThu = item.Data.ngay_nghiem_thu_hd ?? DateTime.Now;
                                        var ngayDuKienKham = item.Data.cau_hinh_ho_so_ksk?.OrderByDescending(x => x.ngay_du_kien_kham).FirstOrDefault()?.ngay_du_kien_kham;
                                        int ngayChenhLechNghiemThu = ngayDuKienKham.HasValue ? (ngayNghiemThu - ngayDuKienKham.Value).Days : 0;
                                        
                                        string bgClassNgiemThu = "";
                                        
                                        if (item.Data.ngay_nghiem_thu_hd == null)
                                        {
                                            bgClassNgiemThu = "text-danger";
                                        }
                                    }
                                    <span class="inline-flex items-center rounded shadow-sm text-xs justify-center px-2 py-1 @bgClassNgiemThu">
                                        @ngayChenhLechNghiemThu
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var ngayThanhToan = item.Data.ngay_thanh_toan ?? DateTime.Now;
                                        int ngayChenhLechThanhToan = ngayDuKienKham.HasValue ? (ngayThanhToan - ngayDuKienKham.Value).Days : 0;
                                        
                                        string bgClassThanhToan = "";
                                        
                                        if (item.Data.ngay_thanh_toan == null)
                                        {
                                            bgClassThanhToan = "text-danger";
                                        }
                                    }
                                    <span class="inline-flex items-center rounded shadow-sm text-xs justify-center px-2 py-1 @bgClassThanhToan">
                                        @ngayChenhLechThanhToan
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
            <CoreAdminWeb.Shared.Components.Pagination TotalItems="@TotalItems" Page="@Page" TotalPages="@TotalPages" PageSize="@PageSize" PageSizeChanged="OnPageSizeChanged" PageChanged="SelectedPage" />
        </div>
    </div>
</div>
