@using CoreAdminWeb.Extensions
@using CoreAdminWeb.Helpers
@using CoreAdminWeb.Model
@using CoreAdminWeb.Model.KhamSucKhoes
@using Microsoft.Extensions.Caching.Memory
@inject IMemoryCache __MemoryCache
<div class="grid grid-cols-1 md:grid-cols-2 gap-3 items-end mb-2">
    <div class="col-span-1 flex items-center gap-2">
        <label class="mb-0 flex-shrink-0 text-sm" style="min-width:120px;white-space:nowrap;">Trái - Có kính:</label>
        <input type="text"
               class="form-input border border-gray-300 rounded-md px-3 py-1 text-sm @(onReadonly || !onReadonly && !onBSMat ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(nameof(SelectedKhamSucKhoeChuyenKhoa.thi_luc_co_kinh_trai))"
               value="@SelectedKhamSucKhoeChuyenKhoa.thi_luc_co_kinh_trai"
               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeChuyenKhoa.thi_luc_co_kinh_trai), isDate: false, item: SelectedKhamSucKhoeChuyenKhoa))"
               readonly="@(onReadonly || !onReadonly && !onBSMat)" />
    </div>
    <div class="col-span-1 flex items-center gap-2">
        <label class="mb-0 flex-shrink-0 text-sm" style="min-width:120px;white-space:nowrap;">Phải - Có kính:</label>
        <input type="text"
               class="form-input border border-gray-300 rounded-md px-3 py-1 text-sm @(onReadonly || !onReadonly && !onBSMat ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(nameof(SelectedKhamSucKhoeChuyenKhoa.thi_luc_co_kinh_phai))"
               value="@SelectedKhamSucKhoeChuyenKhoa.thi_luc_co_kinh_phai"
               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeChuyenKhoa.thi_luc_co_kinh_phai), isDate: false, item: SelectedKhamSucKhoeChuyenKhoa))"
               readonly="@(onReadonly || !onReadonly && !onBSMat)" />
    </div>
    <div class="col-span-1 flex items-center gap-2">
        <label class="mb-0 flex-shrink-0 text-sm" style="min-width:120px;white-space:nowrap;">Trái - không kính:</label>
        <input type="text"
               class="form-input border border-gray-300 rounded-md px-3 py-1 text-sm @(onReadonly || !onReadonly && !onBSMat ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(nameof(SelectedKhamSucKhoeChuyenKhoa.thi_luc_khong_kinh_trai))"
               value="@SelectedKhamSucKhoeChuyenKhoa.thi_luc_khong_kinh_trai"
               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeChuyenKhoa.thi_luc_khong_kinh_trai), isDate: false, item: SelectedKhamSucKhoeChuyenKhoa))"
               readonly="@(onReadonly || !onReadonly && !onBSMat)" />
    </div>
    <div class="col-span-1 flex items-center gap-2">
        <label class="mb-0 flex-shrink-0 text-sm" style="min-width:120px;white-space:nowrap;">Phải - không kính:</label>
        <input type="text"
               class="form-input border border-gray-300 rounded-md px-3 py-1 text-sm @(onReadonly || !onReadonly && !onBSMat ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(nameof(SelectedKhamSucKhoeChuyenKhoa.thi_luc_khong_kinh_phai))"
               value="@SelectedKhamSucKhoeChuyenKhoa.thi_luc_khong_kinh_phai"
               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeChuyenKhoa.thi_luc_khong_kinh_phai), isDate: false, item: SelectedKhamSucKhoeChuyenKhoa))"
               readonly="@(onReadonly || !onReadonly && !onBSMat)" />
    </div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-3 items-end mb-2">
    <div class="col-span-1 flex items-center gap-2">
        <label class="mb-0 flex-shrink-0 text-sm" style="min-width:120px;white-space:nowrap;">Bệnh về mắt:</label>
        <input type="text"
               class="mr-2 form-input border border-gray-300 rounded-md px-3 py-1 text-sm @(onReadonly || !onReadonly && !onBSMat ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(nameof(SelectedKhamSucKhoeChuyenKhoa.benh_mat))"
               value="@SelectedKhamSucKhoeChuyenKhoa.benh_mat"
               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeChuyenKhoa.benh_mat), isDate: false, item: SelectedKhamSucKhoeChuyenKhoa))"
               readonly="@(onReadonly || !onReadonly && !onBSMat)" />
        <Select2 IdSelector="c => c != null ? c.id.ToString() : String.Empty"
                 TextSelector="c => c != null ? c.name : String.Empty"
                 FilterFunction="LoadPhanLoaiSucKhoeDataHandler"
                 GetElementById="async (items, id, token) => items.FirstOrDefault(x => x.id.ToString() == id) ?? new PhanLoaiSucKhoeModel()"
                 Datasource="PhanLoaiSucKhoes"
                 Value="@phanLoaiSucKhoeMat"
                 OnValueChanged="@(args => phanLoaiSucKhoeMatChanged())"
                 Cache="__MemoryCache"
                 Multiselect="false"
                 class="@((onReadonly || !onReadonly && !onBSMat ? "select2-disabled " : "select2-read-write ") + "select2-phan-loai " + dynamicObj.GetHighlightClassIfChanged(nameof(SelectedKhamSucKhoeChuyenKhoa.pl_mat)))" />
    </div>
</div>

@code {
    [Parameter]
    public KhamSucKhoeChuyenKhoaModel SelectedKhamSucKhoeChuyenKhoa { get; set; } = new KhamSucKhoeChuyenKhoaModel();
    [Parameter]
    public bool onReadonly { get; set; } = false;
    [Parameter]
    public bool onBSMat { get; set; } = false;
    [Parameter]
    public object? dynamicObj { get; set; }
    [Parameter]
    public List<PhanLoaiSucKhoeModel> PhanLoaiSucKhoes { get; set; } = new();
    [Parameter]
    public Func<IEnumerable<PhanLoaiSucKhoeModel>, string?, CancellationToken, Task<List<PhanLoaiSucKhoeModel>>>? LoadPhanLoaiSucKhoeData { get; set; }
    [Parameter]
    public Func<ChangeEventArgs, string, bool, bool, object, Task>? OnValueChanged { get; set; }

    private List<PhanLoaiSucKhoeModel>? phanLoaiSucKhoeMat { get; set; } = new List<PhanLoaiSucKhoeModel>();

    protected override void OnParametersSet()
    {
        if ((phanLoaiSucKhoeMat == null || !phanLoaiSucKhoeMat.Any()) && SelectedKhamSucKhoeChuyenKhoa.pl_mat != null)
        {
            phanLoaiSucKhoeMat = new List<PhanLoaiSucKhoeModel> { SelectedKhamSucKhoeChuyenKhoa.pl_mat };
        }
    }

    private async Task<List<PhanLoaiSucKhoeModel>> LoadPhanLoaiSucKhoeDataHandler(IEnumerable<PhanLoaiSucKhoeModel> allItems, string filter, CancellationToken token)
    {
        if (LoadPhanLoaiSucKhoeData != null)
        {
            return await LoadPhanLoaiSucKhoeData.Invoke(allItems, filter, token);
        }
        return new List<PhanLoaiSucKhoeModel>();
    }

    private async Task phanLoaiSucKhoeMatChanged()
    {
        SelectedKhamSucKhoeChuyenKhoa.pl_mat = phanLoaiSucKhoeMat?.FirstOrDefault();
        await OnValueChangedHandler(new ChangeEventArgs() { Value = SelectedKhamSucKhoeChuyenKhoa.pl_mat }, nameof(SelectedKhamSucKhoeChuyenKhoa.pl_mat), isDate: false, item: SelectedKhamSucKhoeChuyenKhoa);
    }

    private async Task OnValueChangedHandler(ChangeEventArgs e, string fieldName, bool isFilter = false, bool isDate = true, object item = default!)
    {
        if (OnValueChanged != null)
        {
            await OnValueChanged.Invoke(e, fieldName, isFilter, isDate, item);
        }
    }
}
