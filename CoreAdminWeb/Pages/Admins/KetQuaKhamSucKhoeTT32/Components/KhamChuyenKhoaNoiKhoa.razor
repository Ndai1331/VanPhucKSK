@code {
    [Parameter]
    public KhamSucKhoeChuyenKhoaModel SelectedKhamSucKhoeChuyenKhoa { get; set; } = new KhamSucKhoeChuyenKhoaModel();
    [Parameter]
    public bool onReadonly { get; set; } = false;
    [Parameter]
    public bool onBSTuanHoan { get; set; } = false;
    [Parameter]
    public bool onBSHoHap { get; set; } = false;
    [Parameter]
    public bool onBSTieuHoa { get; set; } = false;
    [Parameter]
    public bool onBSThanTietNieu { get; set; } = false;
    [Parameter]
    public bool onBSNoiTiet { get; set; } = false;
    [Parameter]
    public bool onBSCoXuongKhop { get; set; } = false;
    [Parameter]
    public bool onBSThanKinh { get; set; } = false;
    [Parameter]
    public bool onBSTamThan { get; set; } = false;
    [Parameter]
    public bool isShowOnlyMe { get; set; } = false;
    [Parameter]
    public object? dynamicObj { get; set; }
    [Parameter]
    public List<PhanLoaiSucKhoeModel> PhanLoaiSucKhoes { get; set; } = new();
    [Parameter]
    public Func<IEnumerable<PhanLoaiSucKhoeModel>, string?, CancellationToken, Task<List<PhanLoaiSucKhoeModel>>>? LoadPhanLoaiSucKhoeData { get; set; }
    [Parameter]
    public Func<ChangeEventArgs, string, bool, bool, object, Task>? OnValueChanged { get; set; }

    protected override void OnParametersSet()
    {
        if ((phanLoaiSucKhoeTuanHoan == null || !phanLoaiSucKhoeTuanHoan.Any()) && SelectedKhamSucKhoeChuyenKhoa.pl_nk_tuan_hoan != null)
        {
            phanLoaiSucKhoeTuanHoan = new List<PhanLoaiSucKhoeModel> { SelectedKhamSucKhoeChuyenKhoa.pl_nk_tuan_hoan };
        }
        if ((phanLoaiSucKhoeHoHap == null || !phanLoaiSucKhoeHoHap.Any()) && SelectedKhamSucKhoeChuyenKhoa.pl_nk_ho_hap != null)
        {
            phanLoaiSucKhoeHoHap = new List<PhanLoaiSucKhoeModel> { SelectedKhamSucKhoeChuyenKhoa.pl_nk_ho_hap };
        }
        if ((phanLoaiSucKhoeTieuHoa == null || !phanLoaiSucKhoeTieuHoa.Any()) && SelectedKhamSucKhoeChuyenKhoa.pl_nk_tieu_hoa != null)
        {
            phanLoaiSucKhoeTieuHoa = new List<PhanLoaiSucKhoeModel> { SelectedKhamSucKhoeChuyenKhoa.pl_nk_tieu_hoa };
        }
        if ((phanLoaiSucKhoeThanTietNieu == null || !phanLoaiSucKhoeThanTietNieu.Any()) && SelectedKhamSucKhoeChuyenKhoa.pl_nk_than_tiet_nieu != null)
        {
            phanLoaiSucKhoeThanTietNieu = new List<PhanLoaiSucKhoeModel> { SelectedKhamSucKhoeChuyenKhoa.pl_nk_than_tiet_nieu };
        }
        if ((phanLoaiSucKhoeNoiTiet == null || !phanLoaiSucKhoeNoiTiet.Any()) && SelectedKhamSucKhoeChuyenKhoa.pl_nk_noi_tiet != null)
        {
            phanLoaiSucKhoeNoiTiet = new List<PhanLoaiSucKhoeModel> { SelectedKhamSucKhoeChuyenKhoa.pl_nk_noi_tiet };
        }
        if ((phanLoaiSucKhoeCoXuongKhop == null || !phanLoaiSucKhoeCoXuongKhop.Any()) && SelectedKhamSucKhoeChuyenKhoa.pl_nk_co_xuong_khop != null)
        {
            phanLoaiSucKhoeCoXuongKhop = new List<PhanLoaiSucKhoeModel> { SelectedKhamSucKhoeChuyenKhoa.pl_nk_co_xuong_khop };
        }
        if ((phanLoaiSucKhoeThanKinh == null || !phanLoaiSucKhoeThanKinh.Any()) && SelectedKhamSucKhoeChuyenKhoa.pl_nk_than_kinh != null)
        {
            phanLoaiSucKhoeThanKinh = new List<PhanLoaiSucKhoeModel> { SelectedKhamSucKhoeChuyenKhoa.pl_nk_than_kinh };
        }
        if ((phanLoaiSucKhoeTamThan == null || !phanLoaiSucKhoeTamThan.Any()) && SelectedKhamSucKhoeChuyenKhoa.pl_nk_tam_than != null)
        {
            phanLoaiSucKhoeTamThan = new List<PhanLoaiSucKhoeModel> { SelectedKhamSucKhoeChuyenKhoa.pl_nk_tam_than };
        }
    }

    private async Task<List<PhanLoaiSucKhoeModel>> LoadPhanLoaiSucKhoeDataHandler(IEnumerable<PhanLoaiSucKhoeModel> allItems, string filter, CancellationToken token)
    {
        if (LoadPhanLoaiSucKhoeData != null)
        {
            return await LoadPhanLoaiSucKhoeData.Invoke(allItems, filter, token);
        }
        return new List<PhanLoaiSucKhoeModel>();
    }

    private List<PhanLoaiSucKhoeModel>? phanLoaiSucKhoeTuanHoan { get; set; } = new List<PhanLoaiSucKhoeModel>();
    private async Task phanLoaiSucKhoeTuanHoanChanged()
    {
        SelectedKhamSucKhoeChuyenKhoa.pl_nk_tuan_hoan = phanLoaiSucKhoeTuanHoan?.FirstOrDefault();
        await OnValueChangedHandler(new ChangeEventArgs() { Value = SelectedKhamSucKhoeChuyenKhoa.pl_nk_tuan_hoan }, nameof(SelectedKhamSucKhoeChuyenKhoa.pl_nk_tuan_hoan), isDate: false, item: SelectedKhamSucKhoeChuyenKhoa);
    }

    private List<PhanLoaiSucKhoeModel>? phanLoaiSucKhoeHoHap { get; set; } = new List<PhanLoaiSucKhoeModel>();
