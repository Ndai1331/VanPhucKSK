    }

    private List<PhanLoaiSucKhoeModel>? phanLoaiSucKhoeCoXuongKhop { get; set; } = new List<PhanLoaiSucKhoeModel>();
    private async Task phanLoaiSucKhoeCoXuongKhopChanged()
    {
        SelectedKhamSucKhoeChuyenKhoa.pl_nk_co_xuong_khop = phanLoaiSucKhoeCoXuongKhop?.FirstOrDefault();
        await OnValueChangedHandler(new ChangeEventArgs() { Value = SelectedKhamSucKhoeChuyenKhoa.pl_nk_co_xuong_khop }, nameof(SelectedKhamSucKhoeChuyenKhoa.pl_nk_co_xuong_khop), isDate: false, item: SelectedKhamSucKhoeChuyenKhoa);
