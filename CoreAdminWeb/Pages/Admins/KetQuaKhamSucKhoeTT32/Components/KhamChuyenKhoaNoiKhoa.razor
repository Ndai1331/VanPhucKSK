    private async Task phanLoaiSucKhoeThanTietNieuChanged()
    {
        SelectedKhamSucKhoeChuyenKhoa.pl_nk_than_tiet_nieu = phanLoaiSucKhoeThanTietNieu?.FirstOrDefault();
