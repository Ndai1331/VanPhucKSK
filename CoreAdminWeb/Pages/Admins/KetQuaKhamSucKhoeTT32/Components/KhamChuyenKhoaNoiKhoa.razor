    private List<PhanLoaiSucKhoeModel>? phanLoaiSucKhoeThanKinh { get; set; } = new List<PhanLoaiSucKhoeModel>();
    private async Task phanLoaiSucKhoeThanKinhChanged()
    {
        SelectedKhamSucKhoeChuyenKhoa.pl_nk_than_kinh = phanLoaiSucKhoeThanKinh?.FirstOrDefault();
        await OnValueChangedHandler(new ChangeEventArgs() { Value = SelectedKhamSucKhoeChuyenKhoa.pl_nk_than_kinh }, nameof(SelectedKhamSucKhoeChuyenKhoa.pl_nk_than_kinh), isDate: false, item: SelectedKhamSucKhoeChuyenKhoa);
    }

    private List<PhanLoaiSucKhoeModel>? phanLoaiSucKhoeTamThan { get; set; } = new List<PhanLoaiSucKhoeModel>();
    private async Task phanLoaiSucKhoeTamThanChanged()
    {
        SelectedKhamSucKhoeChuyenKhoa.pl_nk_tam_than = phanLoaiSucKhoeTamThan?.FirstOrDefault();
        await OnValueChangedHandler(new ChangeEventArgs() { Value = SelectedKhamSucKhoeChuyenKhoa.pl_nk_tam_than }, nameof(SelectedKhamSucKhoeChuyenKhoa.pl_nk_tam_than), isDate: false, item: SelectedKhamSucKhoeChuyenKhoa);
    }

    private async Task OnValueChangedHandler(ChangeEventArgs e, string fieldName, bool isFilter = false, bool isDate = true, object item = default!)
    {
        if (OnValueChanged != null)
        {
            await OnValueChanged.Invoke(e, fieldName, isFilter, isDate, item);
        }
    }
}
