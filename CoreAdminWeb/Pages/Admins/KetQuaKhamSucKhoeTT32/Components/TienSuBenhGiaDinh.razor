@using CoreAdminWeb.Extensions
@using CoreAdminWeb.Model
@using CoreAdminWeb.Model.KhamSucKhoes

<div class="space-y-2 md:col-span-2">
    <MudText Typo="Typo.body1" Class="mb-4 font-bold capitalize text-slate-800 dark:text-slate-100">I. Tiền sử bệnh tật gia đình:</MudText>
    <textarea rows="2"
              class="form-input form-textarea @(onReadonly || !onReadonly && !onBS ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(dynamicObjOriginal, nameof(SelectedKhamSucKhoeTienSu.tien_su_gia_dinh))"
              @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeTienSu.tien_su_gia_dinh), isDate: false, item: SelectedKhamSucKhoeTienSu))"
              readonly="@(onReadonly || !onReadonly && !onBS)">
        @SelectedKhamSucKhoeTienSu.tien_su_gia_dinh
    </textarea>
</div>
<div class="space-y-2 md:col-span-2">
    <MudText Typo="Typo.body1" Class="mb-4 font-bold capitalize text-slate-800 dark:text-slate-100">II. Tiền sử bệnh, tật của bản thân</MudText>
    <MudText Typo="Typo.body1" Class="mb-4 capitalize text-slate-800 dark:text-slate-100">Tiền sử bệnh, tật:</MudText>
    <div class="overflow-auto">
        <table class="display" style="width:100%">
            <thead>
                <tr>
                    <th>Tên bệnh</th>
                    <th>Năm phát hiện</th>
                    <th>Tên bệnh nghề nghiệp</th>
                    <th>Năm phát hiện</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <input class="form-input border border-gray-300 rounded-md px-3 py-1 text-sm @(onReadonly || !onReadonly && !onBS ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(dynamicObjOriginal, nameof(SelectedKhamSucKhoeTienSu.ten_benh))"
                               value="@SelectedKhamSucKhoeTienSu.ten_benh"
                               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeTienSu.ten_benh), isDate: false, item: SelectedKhamSucKhoeTienSu))"
                               readonly="@(onReadonly || !onReadonly && !onBS)" />
                    </td>
                    <td>
                        <input class="form-input border border-gray-300 rounded-md px-3 py-1 text-sm @(onReadonly || !onReadonly && !onBS ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(dynamicObjOriginal, nameof(SelectedKhamSucKhoeTienSu.nam_phat_hien))"
                               value="@SelectedKhamSucKhoeTienSu.nam_phat_hien"
                               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeTienSu.nam_phat_hien), isDate: false, item: SelectedKhamSucKhoeTienSu))"
                               readonly="@(onReadonly || !onReadonly && !onBS)" />
                    </td>
                    <td>
                        <input class="form-input border border-gray-300 rounded-md px-3 py-1 text-sm @(onReadonly || !onReadonly && !onBS ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(dynamicObjOriginal, nameof(SelectedKhamSucKhoeTienSu.benh_nghe_nghiep))"
                               value="@SelectedKhamSucKhoeTienSu.benh_nghe_nghiep"
                               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeTienSu.benh_nghe_nghiep), isDate: false, item: SelectedKhamSucKhoeTienSu))"
                               readonly="@(onReadonly || !onReadonly && !onBS)" />
                    </td>
                    <td>
                        <input class="form-input border border-gray-300 rounded-md px-3 py-1 text-sm @(onReadonly || !onReadonly && !onBS ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(dynamicObjOriginal, nameof(SelectedKhamSucKhoeTienSu.nam_phat_hien_benh_nghe_nghiep))"
                               value="@SelectedKhamSucKhoeTienSu.nam_phat_hien_benh_nghe_nghiep"
                               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeTienSu.nam_phat_hien_benh_nghe_nghiep), isDate: false, item: SelectedKhamSucKhoeTienSu))"
                               readonly="@(onReadonly || !onReadonly && !onBS)" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter]
    public KhamSucKhoeTienSuModel SelectedKhamSucKhoeTienSu { get; set; } = new KhamSucKhoeTienSuModel();
    [Parameter]
    public bool onReadonly { get; set; } = false;
    [Parameter]
    public bool onBS { get; set; } = false;
    [Parameter]
    public object? dynamicObj { get; set; }
    [Parameter]
    public object? dynamicObjOriginal { get; set; }
    [Parameter]
    public Func<ChangeEventArgs, string, bool, bool, object, Task>? OnValueChanged { get; set; }

    private async Task OnValueChangedHandler(ChangeEventArgs e, string fieldName, bool isFilter = false, bool isDate = true, object item = default!)
    {
        if (OnValueChanged != null)
        {
            await OnValueChanged.Invoke(e, fieldName, isFilter, isDate, item);
        }
    }
}
