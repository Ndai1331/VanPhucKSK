@using CoreAdminWeb.Enums
@using CoreAdminWeb.Extensions
@using CoreAdminWeb.Model
@using CoreAdminWeb.Model.KhamSucKhoes
<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    @foreach (var kqcls in SelectedKhamSucKhoeKetQuaCanLamSangs)
    {
        <div>
            <label class="block text-sm font-normal">@kqcls.ten_loai_cls:</label>
            <textarea class="form-input form-textarea w-full border border-gray-300 rounded-md px-3 py-2 @(onReadonly || !onReadonly && !onBSKetLuan ? "" : "read-write")" rows="2" readonly>@kqcls.ket_qua_cls</textarea>
        </div>
    }
</div>
@* @if (!(onReadonly || !onReadonly && !onBSKetLuan))
{
    <div class="flex justify-end">
        <MudButton Class="transition-all duration-300 border btn-crud rounded-md btn text-purple border-purple hover:bg-purple hover:text-white"
                   OnClick="OnLoadKetQuaCanLamSangHandler">
            <i class="ri-loop-right-line"></i>
            Đồng bộ
        </MudButton>
    </div>
} *@

@code {
    [Parameter]
    public List<KetQuaCLSChiTietModel> SelectedKhamSucKhoeKetQuaCanLamSangs { get; set; } = new List<KetQuaCLSChiTietModel>();
    [Parameter]
    public bool onReadonly { get; set; } = false;
    [Parameter]
    public bool onBSKetLuan { get; set; } = false;
    [Parameter]
    public Action? OnLoadKetQuaCanLamSang { get; set; }
    [Parameter]
    public Action<ChangeEventArgs, KetQuaCanLamSang?>? OnKhamCLSChanged { get; set; }

    private void OnLoadKetQuaCanLamSangHandler()
    {
        OnLoadKetQuaCanLamSang?.Invoke();
    }

    private void OnKhamCLSChangedHandler(ChangeEventArgs e, KetQuaCanLamSang? type)
    {
        OnKhamCLSChanged?.Invoke(e, type);
    }
}
