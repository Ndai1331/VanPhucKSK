@using CoreAdminWeb.Extensions
@using CoreAdminWeb.Helpers
@using CoreAdminWeb.Model
@using CoreAdminWeb.Model.KhamSucKhoes
@using Microsoft.Extensions.Caching.Memory
@inject IMemoryCache __MemoryCache
<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-2 items-end">
    <div>
        <label class="block text-sm mb-1" for="chieu-cao">Chiều cao (cm):</label>
        <input id="chieu-cao"
               type="text"
               class="form-input border border-gray-300 rounded-md px-3 py-1 text-right text-sm @(onReadonly || !onReadonly && !onBS ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(dynamicObjOriginal, nameof(SelectedKhamSucKhoeTheLuc.chieu_cao))"
               value="@SelectedKhamSucKhoeTheLuc.chieu_cao?.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)"
               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeTheLuc.chieu_cao), isDate: false, item: SelectedKhamSucKhoeTheLuc))"
               readonly="@(onReadonly || !onReadonly && !onBS)" />
    </div>
    <div>
        <label class="block text-sm mb-1" for="can-nang">Cân nặng (kg):</label>
        <input id="can-nang"
               type="text"
               class="form-input border border-gray-300 rounded-md px-3 py-1 text-right text-sm @(onReadonly || !onReadonly && !onBS ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(dynamicObjOriginal, nameof(SelectedKhamSucKhoeTheLuc.can_nang))"
               value="@SelectedKhamSucKhoeTheLuc.can_nang?.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeTheLuc.can_nang), isDate: false, item: SelectedKhamSucKhoeTheLuc))"
               readonly="@(onReadonly || !onReadonly && !onBS)" />
    </div>
    <div>
        <label class="block text-sm mb-1" for="bmi">BMI:</label>
        <input id="bmi"
               type="text"
               class="form-input border border-gray-300 rounded-md px-3 py-1 text-right text-sm @(onReadonly || !onReadonly && !onBS ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(dynamicObjOriginal, nameof(SelectedKhamSucKhoeTheLuc.bmi))"
               value="@SelectedKhamSucKhoeTheLuc.bmi?.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
               readonly />
    </div>
    <div>
        <label class="block text-sm mb-1" for="abi">ABI:</label>
        <input id="abi"
               type="text"
               class="form-input border border-gray-300 rounded-md px-3 py-1 text-right text-sm @(onReadonly || !onReadonly && !onBS ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(dynamicObjOriginal, nameof(SelectedKhamSucKhoeTheLuc.abi))"
               value="@SelectedKhamSucKhoeTheLuc.abi?.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeTheLuc.abi), isDate: false, item: SelectedKhamSucKhoeTheLuc))"
               readonly="@(onReadonly || !onReadonly && !onBS)" />
    </div>
    <div>
        <label class="block text-sm mb-1" for="mach">Mạch (nhịp/phút):</label>
        <input id="mach"
               type="text"
               class="form-input border border-gray-300 rounded-md px-3 py-1 text-right text-sm @(onReadonly || !onReadonly && !onBS ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(dynamicObjOriginal, nameof(SelectedKhamSucKhoeTheLuc.mach))"
               value="@SelectedKhamSucKhoeTheLuc.mach?.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)"
               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeTheLuc.mach), isDate: false, item: SelectedKhamSucKhoeTheLuc))"
               readonly="@(onReadonly || !onReadonly && !onBS)" />
    </div>
    <div>
        <label class="block text-sm mb-1" for="huyet-ap">Huyết áp (mmHg):</label>
        <input id="huyet-ap" type="text"
               class="form-input border border-gray-300 rounded-md px-3 py-1 text-right text-sm @(onReadonly || !onReadonly && !onBS ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(dynamicObjOriginal, nameof(SelectedKhamSucKhoeTheLuc.huyet_ap))"
               value="@SelectedKhamSucKhoeTheLuc.huyet_ap"
               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeTheLuc.huyet_ap), isDate: false, item: SelectedKhamSucKhoeTheLuc))"
               readonly="@(onReadonly || !onReadonly && !onBS)" />
    </div>
    <div>
        <label class="block text-sm mb-1" for="nhip-tho">Nhịp thở (lần/phút):</label>
        <input id="nhip-tho"
               type="text"
               class="form-input border border-gray-300 rounded-md px-3 py-1 text-right text-sm @(onReadonly || !onReadonly && !onBS ? "" : "read-write") @dynamicObj.GetHighlightClassIfChanged(dynamicObjOriginal, nameof(SelectedKhamSucKhoeTheLuc.nhip_tho))"
               value="@SelectedKhamSucKhoeTheLuc.nhip_tho?.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)"
               @onchange="@(e => OnValueChangedHandler(e, nameof(SelectedKhamSucKhoeTheLuc.nhip_tho), isDate: false, item: SelectedKhamSucKhoeTheLuc))" readonly="@(onReadonly || !onReadonly && !onBS)" />
    </div>
    <div>
        <label class="block text-sm mb-1" for="phan-loai-the-luc">Phân loại thể lực:</label>
        <Select2 IdSelector="c => c != null ? c.id.ToString() : String.Empty"
                 TextSelector="c => c != null ? c.name : String.Empty"
                 FilterFunction="LoadPhanLoaiSucKhoeDataHandler"
                 GetElementById="async (items, id, token) => items.FirstOrDefault(x => x.id.ToString() == id) ?? new PhanLoaiSucKhoeModel()"
                 Datasource="PhanLoaiSucKhoes"
                 Value="@phanLoaiSucKhoeTheLuc"
                 OnValueChanged="@(args => phanLoaiSucKhoeTheLucChanged())"
                 Cache="__MemoryCache"
                 Multiselect="false"
                 class="@((onReadonly || !onReadonly && !onBS ? "select2-disabled " : "select2-read-write ") + "select2-phan-loai " + dynamicObj.GetHighlightClassIfChanged(dynamicObjOriginal, nameof(SelectedKhamSucKhoeTheLuc.phan_loai)))" />
    </div>
</div>

@code {
    [Parameter]
    public KhamSucKhoeTheLucModel SelectedKhamSucKhoeTheLuc { get; set; } = new KhamSucKhoeTheLucModel();
    [Parameter]
    public bool onReadonly { get; set; } = false;
    [Parameter]
    public bool onBS { get; set; } = false;
    [Parameter]
    public object? dynamicObj { get; set; }
    [Parameter]
    public object? dynamicObjOriginal { get; set; }
    [Parameter]
    public List<PhanLoaiSucKhoeModel> PhanLoaiSucKhoes { get; set; } = new();
    [Parameter]
    public Func<IEnumerable<PhanLoaiSucKhoeModel>, string?, CancellationToken, Task<List<PhanLoaiSucKhoeModel>>>? LoadPhanLoaiSucKhoeData { get; set; }
    [Parameter]
    public Func<ChangeEventArgs, string, bool, bool, object, Task>? OnValueChanged { get; set; }

    protected override void OnParametersSet()
    {
        if ((phanLoaiSucKhoeTheLuc == null || !phanLoaiSucKhoeTheLuc.Any()) && SelectedKhamSucKhoeTheLuc.phan_loai != null)
        {
            phanLoaiSucKhoeTheLuc = new List<PhanLoaiSucKhoeModel> { SelectedKhamSucKhoeTheLuc.phan_loai };
        }
    }

    private async Task<List<PhanLoaiSucKhoeModel>> LoadPhanLoaiSucKhoeDataHandler(IEnumerable<PhanLoaiSucKhoeModel> allItems, string filter, CancellationToken token)
    {
        if (LoadPhanLoaiSucKhoeData != null)
        {
            return await LoadPhanLoaiSucKhoeData.Invoke(allItems, filter, token);
        }
        return new List<PhanLoaiSucKhoeModel>();
    }

    private List<PhanLoaiSucKhoeModel>? phanLoaiSucKhoeTheLuc { get; set; } = new List<PhanLoaiSucKhoeModel>();
    private async Task phanLoaiSucKhoeTheLucChanged()
    {
        SelectedKhamSucKhoeTheLuc.phan_loai = phanLoaiSucKhoeTheLuc?.FirstOrDefault();
        await OnValueChangedHandler(new ChangeEventArgs() { Value = SelectedKhamSucKhoeTheLuc.phan_loai }, nameof(SelectedKhamSucKhoeTheLuc.phan_loai), isDate: false, item: SelectedKhamSucKhoeTheLuc);
    }

    private async Task OnValueChangedHandler(ChangeEventArgs e, string fieldName, bool isFilter = false, bool isDate = true, object item = default!)
    {
        if (OnValueChanged != null)
        {
            await OnValueChanged.Invoke(e, fieldName, isFilter, isDate, item);
        }
    }
}
