@page "/admin/bao-cao-theo-doi-don-gia-theo-hop-dong"
@using CoreAdminWeb.Commons.Helpers
@using CoreAdminWeb.Commons.Utils
@using CoreAdminWeb.Enums
@using CoreAdminWeb.Extensions
@using CoreAdminWeb.Helpers
@using CoreAdminWeb.Model
@using CoreAdminWeb.Model.Contract
@using CoreAdminWeb.Services.BaseServices
@using CoreAdminWeb.Shared.Base
@inherits BlazorCoreBase
@layout Shared.Layout.AdminLayout

<PageHeader Title="Báo cáo theo dõi đơn giá theo hợp đồng" pTitle="Báo cáo theo dõi đơn giá theo hợp đồng"></PageHeader>

<!-- Start All Card -->
<div class="flex flex-col gap-4 min-h-[calc(100vh-212px)]">
    <div class="grid grid-cols-1 gap-4">
        <div class="card mb-10">
            <div class="flex items-end justify-between flex-1 gap-2 sm:gap-4">
                <!-- Left: Filter Area -->
                <div class="w-full grid grid-cols-1 gap-4 md:grid-cols-4 xl:grid-cols-4 sm:gap-4 pb-2">
                    <div class="w-full xs:col-span-4 sm:col-span-4 md:col-span-1 xl:col-span-1">
                        <MudText Typo="Typo.h2" Class="mb-1 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Ngày</MudText>
                        <div class="flex items-center gap-2 sm:gap-4">
                            <input type="text"
                                   class="form-input date-picker w-1/2"
                                   placeholder="Từ ngày"
                                   value="@(_fromDate?.ToString("dd/MM/yyyy"))"
                                   @onchange="@(e => OnDateChanged(e, nameof(_fromDate), true))" />
                            <span class="mx-2 flex items-center text-gray-500">-</span>
                            <input type="text"
                                   class="form-input date-picker w-1/2"
                                   placeholder="Đến ngày"
                                   value="@(_toDate?.ToString("dd/MM/yyyy"))"
                                   @onchange="@(e => OnDateChanged(e, nameof(_toDate), true))" />
                        </div>
                    </div>
                    <div class="w-full xs:col-span-4 sm:col-span-4 md:col-span-1 xl:col-span-1">
                        <MudText Typo="Typo.h2" Class="mb-1 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Công ty</MudText>
                        <BlazoredTypeahead EnableDropDown="true"
                                           ShowDropDownOnFocus="true"
                                           MinimumLength="0"
                                           TItem="CongTyModel"
                                           TValue="CongTyModel"
                                           SearchMethod="LoaCongTyFilterData"
                                           Value="_selectedCongTyFilter"
                                           ValueExpression="@(() => _selectedCongTyFilter)"
                                           ValueChanged="OnCongTyFilterChanged"
                                           placeholder="Chọn công ty"
                                           Class="form-select">
                            <SelectedTemplate Context="item">
                                @item.code - @item.name
                            </SelectedTemplate>
                            <ResultTemplate Context="item">
                                @item.code - @item.name
                            </ResultTemplate>
                            <NotFoundTemplate Context="item">
                                Không tìm thấy dữ liệu
                            </NotFoundTemplate>
                        </BlazoredTypeahead>
                    </div>
                    <div class="w-full xs:col-span-4 sm:col-span-4 md:col-span-1 xl:col-span-1">
                        <MudForm class="flex-1">
                            <MudText Typo="Typo.h2" Class="mb-1 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Trạng thái</MudText>
                            <select class="form-select" @bind="_searchStatusString" @bind:event="oninput" @onchange="OnStatusFilterChanged">
                                <option value="">Tất cả</option>
                                @foreach (var item in EnumHelper.ToList<TrangThaiHopDong>())
                                {
                                    <option value="@item.Name" selected="@(_searchStatusString == item.Name)">@item.Description</option>
                                }
                            </select>
                        </MudForm>
                    </div>
                    <div class="w-full xs:col-span-4 sm:col-span-4 md:col-span-1 xl:col-span-1">
                        <MudText Typo="Typo.h2" Class="mb-1 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Hợp đồng</MudText>
                        <BlazoredTypeahead EnableDropDown="true"
                                           ShowDropDownOnFocus="true"
                                           MinimumLength="0"
                                           TItem="ContractModel"
                                           TValue="ContractModel"
                                           SearchMethod="LoaContractFilterData"
                                           Value="_selectedContractFilter"
                                           ValueExpression="@(() => _selectedContractFilter)"
                                           ValueChanged="OnContractFilterChanged"
                                           placeholder="Chọn hợp đồng"
                                           Class="form-select">
                            <SelectedTemplate Context="item">
                                @item.code - @item.name
                            </SelectedTemplate>
                            <ResultTemplate Context="item">
                                @item.code - @item.name
                            </ResultTemplate>
                            <NotFoundTemplate Context="item">
                                Không tìm thấy dữ liệu
                            </NotFoundTemplate>
                        </BlazoredTypeahead>
                    </div>

                    <div class="w-full flex flex-wrap items-end justify-end xs:col-span-4 sm:col-span-4 md:col-span-1 xl:col-span-1 gap-2 flex-row col-end">
                        <MudButton Class="w-full sm:w-auto md:w-auto btn flex items-center justify-center gap-1.5
                            bg-success border-success text-white hover:bg-success/[0.85]
                            hover:border-success/[0.85] text-nowrap" @onclick="@(e => LoadData(true))">
                            <i class="ri-search-line"></i>
                            Thống kê
                        </MudButton>
                        <MudButton Class="w-full sm:w-auto md:w-auto btn flex items-center justify-center gap-1.5
                            bg-info border-info text-white hover:bg-info/[0.85] hover:border-info/[0.85]
                            text-nowrap" OnClick="OnExcelExport">
                            <i class="ri-file-excel-2-fill"></i>
                            Xuất excel
                        </MudButton>
                    </div>
                </div>
            </div>

            <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
                <table id="example" class="display" style="width:100%">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Mã định mức</th>
                            <th>Tên định mức</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Thành tiền</th>
                            <th>Đơn giá hợp đồng</th>
                            <th>Thành tiền hợp đồng</th>
                            <th>Chênh lệch</th>
                            <th>Tỷ lệ (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in MainModels.Select((v, i) => new { Data = v, Index = i }))
                        {
                            <tr>
                                <td>@(((Page - 1) * PageSize) + item.Index + 1)</td>
                                <td>@item.Data.MaDinhMuc</td>
                                <td style="min-width: 300px; white-space: pre-wrap;">@item.Data.TenDinhMuc</td>
                                <td>@item.Data.SoLuong.ToString("N0")</td>
                                <td>@item.Data.DonGiaDM.ToString("N0")</td>
                                <td>@item.Data.ThanhTienDM.ToString("N0")</td>
                                <td>@item.Data.DonGiaTT.ToString("N0")</td>
                                <td>@item.Data.ThanhTienTT.ToString("N0")</td>
                                <td>@((MarkupString)DeltaSpanUtil.RenderDeltaSpan(item.Data.ChenhLech))</td>
                                <td>@((MarkupString)DeltaSpanUtil.RenderDeltaSpan((decimal)item.Data.TyLe, "N2"))</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
            <CoreAdminWeb.Shared.Components.Pagination Page="@Page" TotalPages="@TotalPages" PageSize="@PageSize" PageSizeChanged="OnPageSizeChanged" PageChanged="SelectedPage" />
        </div>
    </div>
</div>
