@page "/electronic-invoice"
@using CoreAdminWeb.Services
@using CoreAdminWeb.Services.Users
@using CoreAdminWeb.Shared.Base
@using CoreAdminWeb.Model
@using CoreAdminWeb.Extensions
@using CoreAdminWeb.Model.User
@using CoreAdminWeb.Services.BaseServices
@layout CoreAdminWeb.Shared.MainLayout
@inherits BlazorCoreBase
@inject NavigationManager Navigation
@inject IBaseGetService<HoaDonDienTuModel> ElectronicInvoiceService
@implements IDisposable

<PageHeader Title="Hóa đơn điện tử" pTitle="Tra cứu hóa đơn điện tử" />

<div class="public-page bg-white flex flex-col gap-4"
     tabindex="0" 
     @onmousemove="@(_ => ResetIdleTimer())"
     @onkeydown="@(_ => ResetIdleTimer())"
     @onclick="@(_ => ResetIdleTimer())"
     @onwheel="@(_ => ResetIdleTimer())"
     @ontouchstart="@(_ => ResetIdleTimer())">
    <div class="w-full grid grid-cols-1 gap-4 md:grid-cols-4 xl:grid-cols-4 sm:gap-4 pb-2">
        <div class="xs:col-span-4 sm:col-span-4 md:col-span-4 xl:col-span-4">
            <div class="gap-4 p-5 bg-light/50 dark:bg-dark rounded-2xl">
                <h3 class="mb-4 text-xl font-semibold dark:text-white">Hướng dẫn tra cứu hoá đơn điện tử</h3>
                <ol class="list-decimal space-y-1 pl-5 leading-7">
                    <li>Nhập mã bệnh nhân để tìm hóa đơn điện tử tương ứng.</li>
                    <li>Chọn hóa đơn cần tra cứu để mở hệ thống hóa đơn điện tử.</li>
                    <li>Nhập <strong>mã số thuế bên bán</strong> vào ô MST bên bán.</li>
                    <li>Nhập <strong>mã số bí mật</strong> vào ô Mã số bí mật.</li>
                    <li>Nhấn nút tìm kiếm trên hệ thống hóa đơn để xem kết quả.</li>
                </ol>
            </div>
        </div>
        <div class="w-full xs:col-span-4 sm:col-span-4 md:col-span-3 xl:col-span-3">
            <MudForm class="flex-1">
                <label for="invoice-patient-id" class="mb-1 block text-base font-semibold text-slate-800 dark:text-slate-100">Nhập mã bệnh nhân để tìm kiếm</label>
                <div class="relative">
                    <input type="text" id="invoice-patient-id" name="patient-id" autocomplete="off" inputmode="text"
                           class="border-black/10 dark:text-white/80 dark:placeholder:text-white/30 dark:border-darkborder dark:bg-dark dark:focus:border-white/30 focus:border-black/30 placeholder:text-black/50 border text-black text-sm rounded block w-full ltr:pl-3 rtl:pr-3 ltr:pr-7 rtl:pl-7 h-10 bg-[#f9fbfd] focus:ring-0 focus:outline-0"
                           placeholder="Nhập mã bệnh nhân..."
                           aria-describedby="invoice-patient-hint"
                           @bind-value="@maBenhNhan"
                           @bind-value:event="oninput"
                           @onkeydown="async (e) => await OnInputKeyDownSearch(e, k => LoadInvoicesAsync(true))">
                    <MudButton OnClick="async (e) => await LoadInvoicesAsync()" type="button" aria-label="Tìm kiếm hóa đơn" title="Tìm kiếm hóa đơn" Class="public-topbar-control absolute inset-y-0 flex items-center text-black ltr:right-0 rtl:left-0 ltr:pr-2 rtl:pl-2 dark:text-white/80">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4" aria-hidden="true">
                            <path d="M11 2C15.968 2 20 6.032 20 11C20 15.968 15.968 20 11 20C6.032 20 2 15.968 2 11C2 6.032 6.032 2 11 2ZM11 18C14.8675 18 18 14.8675 18 11C18 7.1325 14.8675 4 11 4C7.1325 4 4 7.1325 4 11C4 14.8675 7.1325 18 11 18ZM19.4853 18.0711L22.3137 20.8995L20.8995 22.3137L18.0711 19.4853L19.4853 18.0711Z" fill="currentColor"></path>
                        </svg>
                    </MudButton>
                </div>
                <span id="invoice-patient-hint" class="mt-1 block text-sm text-slate-500">Nhập mã bệnh nhân rồi nhấn Enter hoặc Tra cứu.</span>
            </MudForm>
        </div>
        <div class="invoice-search-action xs:col-span-4 sm:col-span-4 md:col-span-1 xl:col-span-1">
            <MudButton type="button" Disabled="@(_isLoading || string.IsNullOrWhiteSpace(maBenhNhan))" Class="public-primary-button mud-button-root mud-button mud-button-text mud-button-text-default mud-button-text-size-medium mud-ripple w-full gap-1.5 text-nowrap" @onclick="@(e => LoadInvoicesAsync(true))">
                <i class="ri-search-line" aria-hidden="true"></i>
                Tra cứu
            </MudButton>
        </div>
    </div>

    <div class="w-full grid grid-cols-1 pb-2">
        <div class="public-surface p-5 dark:bg-darklight dark:border-darkborder" aria-busy="@_isLoading">
            @if (_isLoading)
            {
                <div class="flex justify-center items-center py-12" role="status" aria-live="polite">
                    <div class="loading-spinner" aria-hidden="true"></div>
                    <span class="ml-3 text-slate-600">Đang tải hoá đơn...</span>
                </div>
            }
            else
            {
                if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="public-error-state" role="alert">
                        <div>
                            <p class="font-semibold">Không thể tải hóa đơn</p>
                            <p class="mt-1">@_errorMessage</p>
                            <button type="button" class="public-action-button mt-4 rounded-lg bg-primary px-4 py-2 font-semibold text-white hover:opacity-90" @onclick="() => LoadInvoicesAsync(true)">
                                Thử lại
                            </button>
                        </div>
                    </div>
                }
                else if (MainModels.Any())
                {
                    <div class="p-1">
                        <div class="mb-4 pb-3 border-b border-gray-200 dark:border-darkborder">
                            <h5 class="text-lg font-semibold text-slate-800 dark:text-slate-100 mb-0">
                                <i class="fas fa-list me-2"></i>Danh sách hoá đơn
                            </h5>
                        </div>
                        <div class="public-table-wrap">
                            <MudTable Class="min-w-[640px] text-left w-full" Items="@MainModels" Hover="true" Breakpoint="Breakpoint.None" LoadingProgressColor="Color.Info">
                                <HeaderContent>
                                    <MudTh Class="bg-gray-50 dark:bg-gray-700 font-semibold">STT</MudTh>
                                    <MudTh Class="bg-gray-50 dark:bg-gray-700 font-semibold">Mã lượt khám</MudTh>
                                    <MudTh Class="bg-gray-50 dark:bg-gray-700 font-semibold">Mã số thuế bên bán</MudTh>
                                    <MudTh Class="bg-gray-50 dark:bg-gray-700 font-semibold">Số hoá đơn</MudTh>
                                    <MudTh Class="bg-gray-50 dark:bg-gray-700 font-semibold">Mã số bí mật</MudTh>
                                    <MudTh Class="bg-gray-50 dark:bg-gray-700 font-semibold">Ngày hoá đơn</MudTh>
                                    <MudTh Class="bg-gray-50 dark:bg-gray-700 font-semibold">Mã giao dịch</MudTh>
                                    <MudTh Class="bg-gray-50 dark:bg-gray-700 font-semibold">Tra cứu</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="STT">@(MainModels.IndexOf(context) + 1)</MudTd>
                                    <MudTd DataLabel="Mã lượt khám">@context.ma_luot_kham</MudTd>
                                    <MudTd DataLabel="Mã số thuế bên bán"><button type="button" class="public-copy-button" aria-label="Sao chép mã số thuế bên bán" title="Sao chép mã số thuế bên bán" @onclick="() => CopyToClipboard(context.ma_so_thue)">@context.ma_so_thue</button></MudTd>
                                    <MudTd DataLabel="Số hoá đơn">@context.so_hoa_don</MudTd>
                                    <MudTd DataLabel="Mã số bí mật"><button type="button" class="public-copy-button" aria-label="Sao chép mã số bí mật" title="Sao chép mã số bí mật" @onclick="() => CopyToClipboard(context.ma_hoa_don)">@context.ma_hoa_don</button></MudTd>
                                    <MudTd DataLabel="Ngày hoá đơn">@context.ngay_hoa_don?.ToString("dd/MM/yyyy")</MudTd>
                                    <MudTd DataLabel="Mã giao dịch">@context.ma_giao_dich</MudTd>
                                    <MudTd DataLabel="Thao tác">
                                        <button type="button" class="public-action-button rounded-lg bg-purple px-3 py-2 text-xs font-medium text-white shadow hover:bg-purple transition-colors"
                                                @onclick="@(() => GoToViettelInvoiceSearch(context))">
                                            <i class="ri-eye-line me-1"></i>Tra cứu
                                        </button>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>

                        <CoreAdminWeb.Shared.Components.Pagination TotalItems="@TotalItems" Page="@Page" TotalPages="@TotalPages" PageSize="@PageSize" PageSizeChanged="OnPageSizeChanged" PageChanged="SelectedPage" />
                    </div>

                }
                else if (string.IsNullOrWhiteSpace(maBenhNhan))
                {
                    <div class="public-empty-state">
                        <div>
                            <p class="font-semibold">Nhập mã bệnh nhân để bắt đầu</p>
                            <p class="mt-1 text-sm">Danh sách hóa đơn sẽ xuất hiện sau khi bạn tra cứu.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="public-empty-state">
                        <div>
                            <p class="font-semibold">Không tìm thấy hóa đơn</p>
                            <p class="mt-1 text-sm">Kiểm tra lại mã bệnh nhân và thử tra cứu lần nữa.</p>
                        </div>
                    </div>
                }
            }


        </div>
    </div>
</div>

@code {
    // State management
    private bool _isLoading = true;
    private bool _hasInitialized = false;
    private string? _errorMessage;
    private string maBenhNhan = string.Empty;
    // Data
    private List<HoaDonDienTuModel> MainModels = new List<HoaDonDienTuModel>();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasInitialized)
        {
            _hasInitialized = true;
            StartIdleTimer();
            await InitializePageDataAsync();
        }
    }

    /// <summary>
    /// Initialize page data with proper loading state management
    /// </summary>
    private async Task InitializePageDataAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;
            await LoadInvoicesAsync(true);
        }
        catch (Exception ex)
        {
            AlertService.ShowAlert("Lỗi khi tải dữ liệu: " + ex.Message, "danger");
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Load news posts with optimized error handling
    /// </summary>
    private async Task LoadInvoicesAsync(bool isReset = false)
        {
            _isLoading = true;
            _errorMessage = null;
            StateHasChanged();

        try
        {
            if (isReset)
            {
                ResetPage();
                await Task.Delay(100);
            }

            if (!string.IsNullOrEmpty(maBenhNhan))
            {
                BuilderQuery = $"maBenhNhan={maBenhNhan}&limit={PageSize}&offset={(Page - 1) * PageSize}";

                var result = await ElectronicInvoiceService.GetAllAsync(BuilderQuery);
                if (result.IsSuccess)
                {
                    MainModels = result.Data ?? new List<HoaDonDienTuModel>();
                    if (result.Meta != null)
                    {
                        TotalItems = result.Meta.filter_count ?? 0;
                        TotalPages = (int)Math.Ceiling((double)TotalItems / PageSize);
                    }
                }
                else
                {
                    MainModels = new List<HoaDonDienTuModel>();
                    TotalItems = 0;
                    TotalPages = 0;
                    _errorMessage = "Máy chủ không trả về dữ liệu hóa đơn.";
                }
            }
            else
            {
                MainModels = new List<HoaDonDienTuModel>();
                TotalItems = 0;
                TotalPages = 0;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Vui lòng kiểm tra kết nối và thử lại.";
            AlertService.ShowAlert("Lỗi khi tải hóa đơn: " + ex.Message, "danger");
            MainModels = new List<HoaDonDienTuModel>();
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnPageSizeChanged(int newSize)
    {
        Page = 1;
        PageSize = newSize;
        await LoadInvoicesAsync();
    }

    private async Task SelectedPage(int page)
    {
        Page = page;
        await LoadInvoicesAsync();
    }

    private async Task GoToViettelInvoiceSearch(HoaDonDienTuModel context)
    {
        // new tab and open url
        var url = context.url_tra_cuu;
        if (!string.IsNullOrEmpty(url))
        {
            var success = await JsRuntime.InvokeAsync<bool>("openInNewTab", url);
            if (!success)
            {
                AlertService.ShowAlert("Không thể mở trang tra cứu hóa đơn", "danger");
            }
        }
    }

    // Inactivity auto-redirect to /news after 5 minutes
    private System.Timers.Timer? _idleTimer;
    private const double InactivityMilliseconds = 5 * 60 * 1000; // 5 minutes

    private void StartIdleTimer()
    {
        _idleTimer?.Stop();
        _idleTimer?.Dispose();

        _idleTimer = new System.Timers.Timer(InactivityMilliseconds)
        {
            AutoReset = false,
            Enabled = true
        };
        _idleTimer.Elapsed += async (_, __) =>
        {
            try
            {
                await InvokeAsync(() =>
                {
                    Navigation.NavigateTo("/news", forceLoad: false);
                });
            }
            catch { }
        };
        _idleTimer.Start();
    }

    private void ResetIdleTimer()
    {
        if (_idleTimer == null)
        {
            StartIdleTimer();
            return;
        }
        _idleTimer.Stop();
        _idleTimer.Start();
    }

    private async Task CopyToClipboard(string? text)
    {
        if (string.IsNullOrEmpty(text))
        {
            AlertService.ShowAlert("Không có nội dung để sao chép", "warning");
            return;
        }

        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            AlertService.ShowAlert("Đã sao chép vào clipboard", "success");
        }
        catch
        {
            AlertService.ShowAlert("Không thể sao chép vào clipboard", "danger");
        }
    }

    public void Dispose()
    {
        if (_idleTimer != null)
        {
            _idleTimer.Stop();
            _idleTimer.Dispose();
            _idleTimer = null;
        }
    }
}
