@page "/news"
@using CoreAdminWeb.Services
@using CoreAdminWeb.Services.Users
@using CoreAdminWeb.Shared.Base
@using CoreAdminWeb.Model
@using CoreAdminWeb.Extensions
@using CoreAdminWeb.Model.User
@using CoreAdminWeb.Services.BaseServices
@layout CoreAdminWeb.Shared.MainLayout
@inherits BlazorCoreBase
@inject NavigationManager Navigation
@inject IBaseGetService<PostModel> PostService 

<PageHeader Title="Tin tức" pTitle="Thông báo" />

<div class="public-page flex flex-col gap-4">
    @if (_isLoading)
    {
        <div class="flex justify-center items-center py-12" role="status" aria-live="polite" aria-busy="true">
            <div class="loading-spinner" aria-hidden="true"></div>
            <span class="ml-3 text-slate-600">Đang tải tin tức...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="public-error-state" role="alert">
            <div>
                <p class="font-semibold">Không thể tải danh sách tin tức</p>
                <p class="mt-1">@_errorMessage</p>
                <button type="button" class="public-action-button mt-4 rounded-lg bg-primary px-4 py-2 font-semibold text-white hover:opacity-90" @onclick="InitializePageDataAsync">
                    Thử lại
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-4">
            <div class="public-surface p-2 dark:bg-darklight dark:border-darkborder">
                @if (MainModels.Any())
                {
                    <div>
                        <ul class="space-y-2 overflow-y-auto">
                            @foreach (var post in MainModels)
                            {
                                <li>
                                    <button type="button" class="public-list-card" aria-label="Mở tin tức: @post.title" @onclick="() => ViewPostDetail(post)">
                                        <div class="flex flex-1 items-start gap-3">
                                            <img class="public-list-image" src="@(string.IsNullOrWhiteSpace(post.post_images?.filename_disk) ? "assets/images/no-image-available.svg" : post.post_images.filename_disk)" alt="Ảnh minh họa cho @post.title" width="96" height="96" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/assets/images/no-image-available.svg';">
                                            <div class="min-w-0 flex-1 ltr:text-left rtl:text-right">
                                                <h2 class="public-list-title">@post.title</h2>
                                                <p class="public-list-summary mt-1">@((MarkupString)(post.sort_description ?? string.Empty))</p>
                                                <div class="public-meta mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
                                                    <time datetime="@post.date_created.ToString("yyyy-MM-dd")">@post.date_created.ToString("dd/MM/yyyy")</time>
                                                    <span>@(post.view_count ?? 0) lượt xem</span>
                                                </div>
                                            </div>
                                        </div>
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>

                }
                else
                {
                    <div class="public-empty-state">
                        <div>
                            <p class="font-semibold">Chưa có tin tức nào</p>
                            <p class="mt-1 text-sm">Các thông báo mới sẽ được hiển thị tại đây.</p>
                        </div>
                    </div>
                }
                
                @if (TotalPages > 1)
                {
                    <div class="w-full grid grid-cols-1 pb-2">
                        <CoreAdminWeb.Shared.Components.Pagination TotalItems="@TotalItems" Page="@Page" TotalPages="@TotalPages" PageSize="@PageSize" PageSizeChanged="OnPageSizeChanged" PageChanged="SelectedPage" />
                    </div> 
                }
            </div>


        </div>
    }
</div>

@code {
    // State management
    private bool _isLoading = true;
    private bool _hasInitialized = false;
    private string? _errorMessage;
    
    // Data
    private List<PostModel> MainModels = new List<PostModel>();
    
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasInitialized)
        {
            _hasInitialized = true;
            await InitializePageDataAsync();
        }
    }

    /// <summary>
    /// Initialize page data with proper loading state management
    /// </summary>
    private async Task InitializePageDataAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;
            await LoadPostsAsync(true);
        }
        catch (Exception ex)
        {
            _errorMessage = "Vui lòng kiểm tra kết nối và thử lại.";
            AlertService.ShowAlert("Lỗi khi tải dữ liệu: " + ex.Message, "danger");
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Load news posts with optimized error handling
    /// </summary>
    private async Task LoadPostsAsync(bool isReset = false)
    {
        try
        {
            _errorMessage = null;
            if (isReset)
            {
                ResetPage();
                await Task.Delay(100);
            }

            BuildPaginationQuery(Page, PageSize, "date_created");
            BuilderQuery += $"&filter[_and][0][deleted][_eq]=false";
            BuilderQuery += $"&filter[_and][1][status][_eq]={Model.Base.Status.published.ToString()}";
            BuilderQuery += $"&filter[_and][2][post_catgory][_eq]=2";
            
            var result = await PostService.GetAllAsync(BuilderQuery);
            if (result.IsSuccess)
            {
                MainModels = result.Data ?? new List<PostModel>();
                if (result.Meta != null)
                {
                    TotalItems = result.Meta.filter_count ?? 0;
                    TotalPages = (int)Math.Ceiling((double)TotalItems / PageSize);

                    if (Page > TotalPages)
                    {
                        await SelectedPage(TotalPages);
                    }
                }
            }
            else
            {
                MainModels = new List<PostModel>();
                TotalItems = 0;
                TotalPages = 0;
                _errorMessage = "Máy chủ không trả về danh sách tin tức.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Vui lòng kiểm tra kết nối và thử lại.";
            AlertService.ShowAlert("Lỗi khi tải tin tức: " + ex.Message, "danger");
            MainModels = new List<PostModel>();
        }
    }

    private async Task OnPageSizeChanged(int newSize)
    {
        Page = 1;
        PageSize = newSize;
        await LoadPostsAsync();
    }

    private async Task SelectedPage(int page)
    {
        Page = page;
        await LoadPostsAsync();
    }

    /// <summary>
    /// Load posts for pagination (wrapper method)
    /// </summary>
    private async Task LoadPosts()
    {
        await LoadPostsAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Navigate to post detail with validation
    /// </summary>
    private void ViewPostDetail(PostModel post)
    {
        if (post?.id != null)
        {
            Navigation.NavigateTo($"/news/{post.id}");
        }
    }
} 
